---
import Layout from '@layouts/Page.astro'
import MultiNetwork from '@components/MultiNetwork'
import Network from '@components/Network'
import EmbeddingScatter from '@components/EmbeddingScatter'
import { WeightedNodeLinkDataSchema } from '@lib/networkx'
import { buildDictionaryFromNetworks } from '@build/cedict'
import renPMI from '~/public/ctext/仁_pmi.json'
import yiPMI from '~/public/ctext/義_pmi.json'
import renEmbeds from '~/public/ctext/仁_embeds.json'
import yiEmbeds from '~/public/ctext/義_embeds.json'

const renDict = await buildDictionaryFromNetworks(renPMI)
const yiDict = await buildDictionaryFromNetworks(yiPMI)

const renEmbedNetwork = WeightedNodeLinkDataSchema.parse(renEmbeds)
const yiEmbedNetwork = WeightedNodeLinkDataSchema.parse(yiEmbeds)
---

<Layout>
  <main class="mx-auto w-full px-4 py-8">
    <div class="items-center justify-center xl:flex">
      <div class="xl:w-1/2">
        <MultiNetwork
          client:load
          data="/ctext/仁_pmi.json"
          sourceAlign="left"
          dictionary={renDict}
        />
      </div>
      <div class="mt-8 xl:mt-0 xl:w-1/2">
        <MultiNetwork
          client:load
          data="/sep/benevolence_pmi.json"
          sourceAlign="right"
        />
      </div>
    </div>
    <div class="mx-auto max-w-screen-xl">
      <Network
        client:only
        centralNodeId="仁"
        data={renEmbedNetwork}
        dictionary={renDict}
      />
      <Network
        client:only
        centralNodeId="義"
        data={yiEmbedNetwork}
        dictionary={yiDict}
      />
    </div>
    <div class="mx-auto mt-12 max-w-screen-xl">
      <h2 class="mb-4 text-xl font-bold">Embedding spaces (PCA / t-SNE)</h2>
      <div class="items-start justify-center gap-8 xl:flex">
        <div class="xl:w-1/2">
          <EmbeddingScatter client:only="react" data="/embeddings/mengzi.json" />
        </div>
        <div class="mt-8 xl:mt-0 xl:w-1/2">
          <EmbeddingScatter client:only="react" data="/embeddings/sep.json" />
        </div>
      </div>
    </div>
  </main>
</Layout>
