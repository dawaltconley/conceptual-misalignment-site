---
import Layout from '@layouts/Page.astro'
import TermNetwork from '@components/TermNetwork'
import { buildDictionaryFromFiles, buildDictionary } from '@build/cedict'
import { isNotEmpty } from '@lib/utils'
import { MasterSchema } from '@lib/terms'
import termsJson from '@data/terms.json'
import { EmbeddingDatasetSchema } from '@lib/embeddings'
import mengziEmbeds from '~/public/embeddings/mengzi.json'
import EmbeddingScatter from '@components/EmbeddingScatter'
import AlignmentScatter from '@components/AlignmentScatter'

const master = MasterSchema.parse(termsJson)

// Dictionary over every hanzi in the Chinese networks — co-occurrence and
// similarity — read at build time.
const networkDataPaths = master.terms
  .flatMap((t) => [...t.chinese.cooccurrence, ...t.chinese.similarity])
  .map((s) => s.data)
  .filter(isNotEmpty)
const networkDictionary = await buildDictionaryFromFiles(networkDataPaths)

const embeddingData = EmbeddingDatasetSchema.parse(mengziEmbeds)
const embeddingDictionary = await buildDictionary(
  embeddingData.nodes.map((n) => n.id),
)
---

<Layout>
  <main class="mx-auto w-full px-4 py-8">
    <h2 class="mb-4 text-xl font-bold">Co-occurrence networks</h2>
    <TermNetwork
      client:load
      kind="cooccurrence"
      data={master}
      dictionary={networkDictionary}
    />

    <h2 class="mb-4 mt-12 text-xl font-bold">Similarity networks</h2>
    <TermNetwork
      client:load
      kind="similarity"
      data={master}
      dictionary={networkDictionary}
    />

    <div class="mx-auto mt-12 max-w-screen-xl">
      <h2 class="mb-4 text-xl font-bold">Embedding spaces (PCA / t-SNE)</h2>
      <div class="items-start justify-center gap-8 xl:flex">
        <div class="xl:w-1/2">
          <EmbeddingScatter
            client:only="react"
            terms={master.terms}
            data="/embeddings/mengzi.json"
            dictionary={embeddingDictionary}
          />
        </div>
        <div class="mt-8 xl:mt-0 xl:w-1/2">
          <EmbeddingScatter
            terms={master.terms}
            client:only="react"
            data="/embeddings/sep.json"
          />
        </div>
      </div>
    </div>
    <div class="mx-auto mt-12 max-w-screen-xl">
      <h2 class="mb-4 text-xl font-bold">Cross-lingual alignment</h2>
      <div class="mx-auto max-w-2xl">
        <AlignmentScatter
          client:only="react"
          chinese="/embeddings/mengzi.json"
          english="/embeddings/sep.json"
          dictionary={embeddingDictionary}
        />
      </div>
    </div>
  </main>
</Layout>
