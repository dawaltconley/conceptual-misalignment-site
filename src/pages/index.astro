---
import Layout from '@layouts/Page.astro'
import MultiNetwork from '@components/MultiNetwork'
import { TermSchema } from '@lib/networkx'
import { buildDictionary } from '@build/cedict'
import renRaw from '~/public/ctext/仁_pmi.json'

const ren = TermSchema.parse(renRaw)

const hanzi = ren.sources
  .map((s) => s.co_occurance.nodes)
  .flat()
  .map((n) => n.id.toString())
const renDict = await buildDictionary(hanzi)
---

<Layout>
  <main class="mx-auto w-full px-4 py-8">
    <div class="items-center justify-center xl:flex">
      <div class="xl:w-1/2">
        <MultiNetwork
          client:load
          data="/ctext/仁_pmi.json"
          sourceAlign="left"
          dictionary={renDict}
        />
      </div>
      <div class="mt-8 xl:mt-0 xl:w-1/2">
        <MultiNetwork
          client:load
          data="/sep/benevolence_pmi.json"
          sourceAlign="right"
        />
      </div>
    </div>
  </main>
</Layout>
