---
import Layout from '@layouts/Page.astro'
import MultiNetwork from '@components/MultiNetwork'
import { TermSchema } from '@lib/networkx'
import { buildDictionary } from '@build/cedict'
import benevolenceRaw from '@data/pmi/sep/benevolence.json'
import renRaw from '@data/pmi/ctext/仁.json'

const benevolence = TermSchema.parse(benevolenceRaw)
const ren = TermSchema.parse(renRaw)

const hanzi = ren.sources
  .map((s) => s.co_occurance.nodes)
  .flat()
  .map((n) => n.id.toString())
const renDict = await buildDictionary(hanzi)
---

<Layout>
  <main class="mx-auto w-full px-4 py-8">
    <div class="items-center justify-center xl:flex">
      <div class="xl:w-1/2">
        <MultiNetwork
          client:only
          data={ren}
          sourceAlign="left"
          dictionary={renDict}
        />
      </div>
      <div class="mt-8 xl:mt-0 xl:w-1/2">
        <MultiNetwork client:only data={benevolence} sourceAlign="right" />
      </div>
    </div>
  </main>
</Layout>
