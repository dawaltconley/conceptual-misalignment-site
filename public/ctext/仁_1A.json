{"term": {"label": "仁", "variants": []}, "source": {"id": "1A", "url": "https://ctext.org/mengzi/liang-hui-wang-i", "title": "梁惠王上", "description": "孟子見梁惠王。王曰：「叟不遠千里而來，亦將有以利吾國乎？」\n孟子對曰：「王何必曰利？亦有仁義而已矣。王曰『何以利吾國』？大夫曰『何以利吾家』？士庶人曰『何以利吾身』？上下交征利而國危矣。萬乘之國弒其君者，必千乘之家；千乘之國弒其君者，必百乘之家。萬取千焉，千取百焉，不為不多矣。苟為後義而先利，不奪不饜。未有仁而遺其親者", "occurrences": 8, "data": null}, "network": {"directed": false, "multigraph": false, "graph": {}, "nodes": [{"form": "下", "id": "下"}, {"form": "人", "id": "人"}, {"form": "仁", "variants": [], "id": "仁"}, {"form": "內", "id": "內"}, {"form": "刃", "id": "刃"}, {"form": "利", "id": "利"}, {"form": "制", "id": "制"}, {"form": "加", "id": "加"}, {"form": "君", "id": "君"}, {"form": "國", "id": "國"}, {"form": "多", "id": "多"}, {"form": "孝悌", "id": "孝悌"}, {"form": "小", "id": "小"}, {"form": "後", "id": "後"}, {"form": "政", "id": "政"}, {"form": "敵", "id": "敵"}, {"form": "望", "id": "望"}, {"form": "東", "id": "東"}, {"form": "民", "id": "民"}, {"form": "河", "id": "河"}, {"form": "沼", "id": "沼"}, {"form": "父母", "id": "父母"}, {"form": "王", "id": "王"}, {"form": "異", "id": "異"}, {"form": "義", "id": "義"}, {"form": "行", "id": "行"}], "edges": [{"weight": 1.455287232606842, "source": "下", "target": "民"}, {"weight": 0.5389965007326869, "source": "人", "target": "民"}, {"weight": 1.0986122886681098, "source": "人", "target": "加"}, {"weight": 1.5040773967762742, "source": "人", "target": "多"}, {"weight": 1.0986122886681098, "source": "人", "target": "異"}, {"weight": 1.0986122886681098, "source": "人", "target": "刃"}, {"weight": 1.5040773967762742, "source": "人", "target": "望"}, {"weight": 0.4054651081081644, "source": "人", "target": "仁"}, {"weight": 3.4011973816621555, "source": "多", "target": "加"}, {"weight": 2.1484344131667874, "source": "多", "target": "民"}, {"weight": 3.8066624897703196, "source": "多", "target": "望"}, {"weight": 0.8888917576860407, "source": "多", "target": "王"}, {"weight": 2.0149030205422647, "source": "國", "target": "利"}, {"weight": 2.302585092994046, "source": "國", "target": "君"}, {"weig