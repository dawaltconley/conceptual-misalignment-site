{"chapter": "7A", "id": 0, "passage": "孟子曰：「盡其心者，知其性也。知其性，則知天矣。存其心，養其性，所以事天也。殀壽不貳，修身以俟之，所以立命也。」", "tokens": ["孟子", "曰", "：", "「", "盡", "其", "心", "者", "，", "知", "其", "性", "也", "。", "知", "其", "性", "，", "則", "知", "天", "矣", "。", "存", "其", "心", "，", "養", "其", "性", "，", "所", "以", "事", "天", "也", "。", "殀", "壽", "不", "貳", "，", "修", "身", "以", "俟", "之", "，", "所", "以", "立", "命", "也", "。", "」"]}
{"chapter": "7A", "id": 1, "passage": "孟子曰：「莫非命也，順受其正。是故知命者，不立乎巖牆之下。盡其道而死者，正命也。桎梏死者，非正命也。」", "tokens": ["孟子", "曰", "：", "「", "莫", "非", "命", "也", "，", "順", "受", "其", "正", "。", "是", "故", "知", "命", "者", "，", "不", "立", "乎", "巖", "牆", "之", "下", "。", "盡", "其", "道", "而", "死", "者", "，", "正", "命", "也", "。", "桎梏", "死", "者", "，", "非", "正", "命", "也", "。", "」"]}
{"chapter": "7A", "id": 2, "passage": "孟子曰：「求則得之，舍則失之，是求有益於得也，求在我者也。求之有道，得之有命，是求無益於得也，求在外者也。」", "tokens": ["孟子", "曰", "：", "「", "求", "則", "得", "之", "，", "舍", "則", "失", "之", "，", "是", "求", "有", "益", "於", "得", "也", "，", "求", "在", "我", "者", "也", "。", "求", "之", "有", "道", "，", "得", "之", "有", "命", "，", "是", "求", "無", "益", "於", "得", "也", "，", "求", "在", "外", "者", "也", "。", "」"]}
{"chapter": "7A", "id": 3, "passage": "孟子曰：「萬物皆備於我矣。反身而誠，樂莫大焉。強恕而行，求仁莫近焉。」", "tokens": ["孟子", "曰", "：", "「", "萬物", "皆", "備", "於", "我", "矣", "。", "反", "身", "而", "誠", "，", "樂", "莫", "大", "焉", "。", "強", "恕", "而", "行", "，", "求", "仁", "莫", "近", "焉", "。", "」"]}
{"chapter": "7A", "id": 4, "passage": "孟子曰：「行之而不著焉，習矣而不察焉，終身由之而不知其道者，眾也。」", "tokens": ["孟子", "曰", "：", "「", "行", "之", "而", "不", "著", "焉", "，", "習", "矣", "而", "不", "察", "焉", "，", "終身", "由", "之", "而", "不", "知", "其", "道", "者", "，", "眾", "也", "。", "」"]}
{"chapter": "7A", "id": 5, "passage": "孟子曰：「人不可以無恥。無恥之恥，無恥矣。」", "tokens": ["孟子", "曰", "：", "「", "人", "不", "可以", "無", "恥", "。", "無", "恥", "之", "恥", "，", "無", "恥", "矣", "。", "」"]}
{"chapter": "7A", "id": 6, "passage": "孟子曰：「恥之於人大矣。為機變之巧者，無所用恥焉。不恥不若人，何若人有？」", "tokens": ["孟子", "曰", "：", "「", "恥", "之", "於", "人", "大", "矣", "。", "為", "機變", "之", "巧", "者", "，", "無", "所", "用", "恥", "焉", "。", "不", "恥", "不", "若", "人", "，", "何", "若", "人", "有", "？", "」"]}
{"chapter": "7A", "id": 7, "passage": "孟子曰：「古之賢王好善而忘勢，古之賢士何獨不然？樂其道而忘人之勢。故王公不致敬盡禮，則不得亟見之。見且猶不得亟，而況得而臣之乎？」", "tokens": ["孟子", "曰", "：", "「", "古", "之", "賢", "王", "好", "善", "而", "忘", "勢", "，", "古", "之", "賢", "士", "何", "獨", "不", "然", "？", "樂", "其", "道", "而", "忘", "人", "之", "勢", "。", "故", "王公", "不", "致敬", "盡", "禮", "，", "則", "不", "得", "亟", "見", "之", "。", "見", "且", "猶", "不", "得", "亟", "，", "而", "況", "得", "而", "臣", "之", "乎", "？", "」"]}
{"chapter": "7A", "id": 8, "passage": "孟子謂宋句踐曰：「子好遊乎？吾語子遊。人知之，亦囂囂；人不知，亦囂囂。」", "tokens": ["孟子", "謂", "宋句踐", "曰", "：", "「", "子", "好", "遊", "乎", "？", "吾", "語", "子", "遊", "。", "人", "知", "之", "，", "亦", "囂囂", "；", "人", "不", "知", "，", "亦", "囂囂", "。", "」"]}
{"chapter": "7A", "id": 9, "passage": "曰：「何如斯可以囂囂矣？」", "tokens": ["曰", "：", "「", "何", "如", "斯", "可", "以", "囂", "囂", "矣", "？", "」"]}
{"chapter": "7A", "id": 10, "passage": "曰：「尊德樂義，則可以囂囂矣。故士窮不失義，達不離道。窮不失義，故士得己焉；達不離道，故民不失望焉。古之人，得志，澤加於民；不得志，脩身見於世。窮則獨善其身，達則兼善天下。」", "tokens": ["曰", "：", "「", "尊", "德", "樂", "義", "，", "則", "可", "以", "囂", "囂", "矣", "。", "故", "士", "窮", "不", "失", "義", "，", "達", "不", "離", "道", "。", "窮", "不", "失", "義", "，", "故", "士", "得", "己", "焉", "；", "達", "不", "離", "道", "，", "故", "民", "不", "失", "望", "焉", "。", "古", "之", "人", "，", "得", "志", "，", "澤", "加", "於", "民", "；", "不", "得", "志", "，", "脩", "身", "見", "於", "世", "。", "窮", "則", "獨", "善", "其", "身", "，", "達", "則", "兼", "善", "天下", "。", "」"]}
{"chapter": "7A", "id": 11, "passage": "孟子曰：「待文王而後興者，凡民也。若夫豪傑之士，雖無文王猶興。」", "tokens": ["孟子", "曰", "：", "「", "待", "文王", "而", "後", "興", "者", "，", "凡", "民", "也", "。", "若", "夫", "豪傑", "之", "士", "，", "雖", "無", "文王", "猶", "興", "。", "」"]}
{"chapter": "7A", "id": 12, "passage": "孟子曰：「附之以韓魏之家，如其自視欿然，則過人遠矣。」", "tokens": ["孟子", "曰", "：", "「", "附", "之", "以", "韓", "魏", "之", "家", "，", "如", "其", "自", "視", "欿然", "，", "則", "過", "人", "遠", "矣", "。", "」"]}
{"chapter": "7A", "id": 13, "passage": "孟子曰：「以佚道使民，雖勞不怨；以生道殺民，雖死不怨殺者。」", "tokens": ["孟子", "曰", "：", "「", "以", "佚道", "使", "民", "，", "雖", "勞", "不", "怨", "；", "以", "生道", "殺", "民", "，", "雖", "死", "不", "怨", "殺", "者", "。", "」"]}
{"chapter": "7A", "id": 14, "passage": "孟子曰：「霸者之民，驩虞如也；王者之民，皞皞如也。殺之而不怨，利之而不庸，民日遷善而不知為之者。夫君子所過者化，所存者神，上下與天地同流，豈曰小補之哉？」", "tokens": ["孟子", "曰", "：", "「", "霸", "者", "之", "民", "，", "驩", "虞", "如", "也", "；", "王", "者", "之", "民", "，", "皞", "皞", "如", "也", "。", "殺", "之", "而", "不", "怨", "，", "利", "之", "而", "不", "庸", "，", "民", "日", "遷", "善", "而", "不", "知", "為", "之", "者", "。", "夫", "君子", "所", "過", "者", "化", "，", "所", "存", "者", "神", "，", "上", "下", "與", "天地", "同", "流", "，", "豈", "曰", "小", "補", "之", "哉", "？", "」"]}
{"chapter": "7A", "id": 15, "passage": "孟子曰：「仁言，不如仁聲之入人深也。善政，不如善教之得民也。善政民畏之，善教民愛之；善政得民財，善教得民心。」", "tokens": ["孟子", "曰", "：", "「", "仁", "言", "，", "不如", "仁", "聲", "之", "入", "人", "深", "也", "。", "善", "政", "，", "不如", "善", "教", "之", "得", "民", "也", "。", "善", "政", "民", "畏", "之", "，", "善", "教", "民", "愛", "之", "；", "善", "政", "得", "民", "財", "，", "善", "教", "得", "民心", "。", "」"]}
{"chapter": "7A", "id": 16, "passage": "孟子曰：「人之所不學而能者，其良能也；所不慮而知者，其良知也。孩提之童，無不知愛其親者；及其長也，無不知敬其兄也。親親，仁也；敬長，義也。無他，達之天下也。」", "tokens": ["孟子", "曰", "：", "「", "人", "之", "所", "不", "學", "而", "能", "者", "，", "其", "良", "能", "也", "；", "所", "不", "慮", "而", "知", "者", "，", "其", "良", "知", "也", "。", "孩", "提", "之", "童", "，", "無", "不", "知", "愛", "其", "親", "者", "；", "及", "其", "長", "也", "，", "無", "不", "知", "敬", "其", "兄", "也", "。", "親", "親", "，", "仁", "也", "；", "敬", "長", "，", "義", "也", "。", "無", "他", "，", "達", "之", "天下", "也", "。", "」"]}
{"chapter": "7A", "id": 17, "passage": "孟子曰：「舜之居深山之中，與木石居，與鹿豕遊，其所以異於深山之野人者幾希。及其聞一善言，見一善行，若決江河，沛然莫之能禦也。」", "tokens": ["孟子", "曰", "：", "「", "舜", "之", "居", "深山", "之", "中", "，", "與", "木石", "居", "，", "與", "鹿豕", "遊", "，", "其", "所", "以", "異", "於", "深山", "之", "野人", "者", "幾", "希", "。", "及", "其", "聞", "一", "善", "言", "，", "見", "一", "善", "行", "，", "若", "決", "江河", "，", "沛然", "莫", "之", "能", "禦", "也", "。", "」"]}
{"chapter": "7A", "id": 18, "passage": "孟子曰：「無為其所不為，無欲其所不欲，如此而已矣。」", "tokens": ["孟子", "曰", "：", "「", "無", "為", "其", "所", "不", "為", "，", "無", "欲", "其", "所", "不", "欲", "，", "如此", "而", "已", "矣", "。", "」"]}
{"chapter": "7A", "id": 19, "passage": "孟子曰：「人之有德慧術知者，恒存乎疢疾。獨孤臣孽子，其操心也危，其慮患也深，故達。」", "tokens": ["孟子", "曰", "：", "「", "人", "之", "有", "德", "慧", "術", "知", "者", "，", "恒", "存", "乎", "疢", "疾", "。", "獨", "孤", "臣", "孽", "子", "，", "其", "操", "心", "也", "危", "，", "其", "慮", "患", "也", "深", "，", "故", "達", "。", "」"]}
{"chapter": "7A", "id": 20, "passage": "孟子曰：「有事君人者，事是君則為容悅者也。有安社稷臣者，以安社稷為悅者也。有天民者，達可行於天下而後行之者也。有大人者，正己而物正者也。」", "tokens": ["孟子", "曰", "：", "「", "有", "事", "君", "人", "者", "，", "事", "是", "君", "則", "為", "容", "悅", "者", "也", "。", "有", "安", "社稷", "臣", "者", "，", "以", "安", "社稷", "為", "悅", "者", "也", "。", "有", "天民", "者", "，", "達", "可", "行", "於", "天下", "而", "後", "行", "之", "者", "也", "。", "有", "大人", "者", "，", "正", "己", "而", "物", "正", "者", "也", "。", "」"]}
{"chapter": "7A", "id": 21, "passage": "孟子曰：「君子有三樂，而王天下不與存焉。父母俱存，兄弟無故，一樂也。仰不愧於天，俯不怍於人，二樂也。得天下英才而教育之，三樂也。君子有三樂，而王天下不與存焉。」", "tokens": ["孟子", "曰", "：", "「", "君子", "有", "三", "樂", "，", "而", "王", "天下", "不", "與", "存", "焉", "。", "父母", "俱", "存", "，", "兄弟", "無", "故", "，", "一", "樂", "也", "。", "仰", "不", "愧", "於", "天", "，", "俯", "不", "怍", "於", "人", "，", "二", "樂", "也", "。", "得", "天下", "英才", "而", "教育", "之", "，", "三", "樂", "也", "。", "君子", "有", "三", "樂", "，", "而", "王", "天下", "不", "與", "存", "焉", "。", "」"]}
{"chapter": "7A", "id": 22, "passage": "孟子曰：「廣土眾民，君子欲之，所樂不存焉。中天下而立，定四海之民，君子樂之，所性不存焉。君子所性，雖大行不加焉，雖窮居不損焉，分定故也。君子所性，仁義禮智根於心。其生色也，睟然見於面，盎於背，施於四體，四體不言而喻。」", "tokens": ["孟子", "曰", "：", "「", "廣", "土", "眾", "民", "，", "君子", "欲", "之", "，", "所", "樂", "不", "存", "焉", "。", "中", "天下", "而", "立", "，", "定", "四", "海", "之", "民", "，", "君子", "樂", "之", "，", "所", "性", "不", "存", "焉", "。", "君子", "所", "性", "，", "雖", "大", "行", "不", "加", "焉", "，", "雖", "窮", "居", "不", "損", "焉", "，", "分", "定", "故", "也", "。", "君子", "所", "性", "，", "仁", "義", "禮", "智", "根", "於", "心", "。", "其", "生", "色", "也", "，", "睟然", "見", "於", "面", "，", "盎", "於", "背", "，", "施", "於", "四", "體", "，", "四", "體", "不", "言", "而", "喻", "。", "」"]}
{"chapter": "7A", "id": 23, "passage": "孟子曰：「伯夷辟紂，居北海之濱，聞文王作興，曰：『盍歸乎來！吾聞西伯善養老者。』太公辟紂，居東海之濱，聞文王作興，曰：『盍歸乎來！吾聞西伯善養老者。』天下有善養老，則仁人以為己歸矣。五畝之宅，樹牆下以桑，匹婦蠶之，則老者足以衣帛矣。五母雞，二母彘，無失其時，老者足以無失肉矣。百畝之田，匹夫耕之，八口之家足以無飢矣。所謂西伯善養老者，制其田里，教之樹畜，導其妻子，使養其老。五十非帛不煖，七十非肉不飽。不煖不飽，謂之凍餒。文王之民，無凍餒之老者，此之謂也。」", "tokens": ["孟子", "曰", "：", "「", "伯夷", "辟", "紂", "，", "居", "北海", "之", "濱", "，", "聞", "文王", "作", "興", "，", "曰", "：", "『", "盍", "歸", "乎", "來", "！", "吾", "聞", "西伯", "善", "養", "老", "者", "。", "』", "太公", "辟", "紂", "，", "居", "東海", "之", "濱", "，", "聞", "文王", "作", "興", "，", "曰", "：", "『", "盍", "歸", "乎", "來", "！", "吾", "聞", "西伯", "善", "養", "老", "者", "。", "』", "天下", "有", "善", "養", "老", "，", "則", "仁", "人", "以", "為", "己", "歸", "矣", "。", "五", "畝", "之", "宅", "，", "樹", "牆", "下", "以", "桑", "，", "匹", "婦", "蠶", "之", "，", "則", "老", "者", "足", "以", "衣", "帛", "矣", "。", "五", "母", "雞", "，", "二", "母", "彘", "，", "無", "失", "其", "時", "，", "老", "者", "足", "以", "無", "失", "肉", "矣", "。", "百", "畝", "之", "田", "，", "匹", "夫", "耕", "之", "，", "八", "口", "之", "家", "足", "以", "無", "飢", "矣", "。", "所", "謂", "西伯", "善", "養", "老", "者", "，", "制", "其", "田", "里", "，", "教", "之", "樹", "畜", "，", "導", "其", "妻", "子", "，", "使", "養", "其", "老", "。", "五十", "非", "帛", "不", "煖", "，", "七十", "非", "肉", "不", "飽", "。", "不", "煖", "不", "飽", "，", "謂", "之", "凍餒", "。", "文王", "之", "民", "，", "無", "凍餒", "之", "老者", "，", "此", "之", "謂", "也", "。", "」"]}
{"chapter": "7A", "id": 24, "passage": "孟子曰：「易其田疇，薄其稅斂，民可使富也。食之以時，用之以禮，財不可勝用也。民非水火不生活，昏暮叩人之門戶，求水火，無弗與者，至足矣。聖人治天下，使有菽粟如水火。菽粟如水火，而民焉有不仁者乎？」", "tokens": ["孟子", "曰", "：", "「", "易", "其", "田疇", "，", "薄", "其", "稅斂", "，", "民", "可", "使", "富", "也", "。", "食", "之", "以", "時", "，", "用", "之", "以", "禮", "，", "財", "不", "可", "勝", "用", "也", "。", "民", "非", "水", "火", "不", "生活", "，", "昏", "暮", "叩", "人", "之", "門", "戶", "，", "求", "水", "火", "，", "無", "弗", "與", "者", "，", "至", "足", "矣", "。", "聖人", "治", "天下", "，", "使", "有", "菽粟", "如", "水", "火", "。", "菽粟", "如", "水", "火", "，", "而", "民", "焉", "有", "不", "仁", "者", "乎", "？", "」"]}
{"chapter": "7A", "id": 25, "passage": "孟子曰：「孔子登東山而小魯，登太山而小天下。故觀於海者難為水，遊於聖人之門者難為言。觀水有術，必觀其瀾。日月有明，容光必照焉。流水之為物也，不盈科不行；君子之志於道也，不成章不達。」", "tokens": ["孟子", "曰", "：", "「", "孔子", "登", "東山", "而", "小", "魯", "，", "登", "太山", "而", "小", "天下", "。", "故", "觀", "於", "海", "者", "難", "為", "水", "，", "遊", "於", "聖人", "之", "門", "者", "難", "為", "言", "。", "觀", "水", "有", "術", "，", "必", "觀", "其", "瀾", "。", "日", "月", "有", "明", "，", "容", "光", "必", "照", "焉", "。", "流水", "之", "為", "物", "也", "，", "不", "盈", "科", "不", "行", "；", "君子", "之", "志", "於", "道", "也", "，", "不", "成", "章", "不", "達", "。", "」"]}
{"chapter": "7A", "id": 26, "passage": "孟子曰：「雞鳴而起，孳孳為善者，舜之徒也。雞鳴而起，孳孳為利者，蹠之徒也。欲知舜與蹠之分，無他，利與善之閒也。」", "tokens": ["孟子", "曰", "：", "「", "雞", "鳴", "而", "起", "，", "孳孳", "為", "善", "者", "，", "舜", "之", "徒", "也", "。", "雞", "鳴", "而", "起", "，", "孳孳", "為", "利", "者", "，", "蹠", "之", "徒", "也", "。", "欲", "知", "舜", "與", "蹠", "之", "分", "，", "無", "他", "，", "利", "與", "善", "之", "閒", "也", "。", "」"]}
{"chapter": "7A", "id": 27, "passage": "孟子曰：「楊子取為我，拔一毛而利天下，不為也。墨子兼愛，摩頂放踵利天下，為之。子莫執中，執中為近之，執中無權，猶執一也。所惡執一者，為其賊道也，舉一而廢百也。」", "tokens": ["孟子", "曰", "：", "「", "楊子", "取", "為", "我", "，", "拔", "一", "毛", "而", "利", "天下", "，", "不", "為", "也", "。", "墨子", "兼", "愛", "，", "摩", "頂", "放", "踵", "利", "天下", "，", "為", "之", "。", "子莫", "執", "中", "，", "執", "中", "為", "近", "之", "，", "執", "中", "無", "權", "，", "猶", "執", "一", "也", "。", "所", "惡", "執", "一", "者", "，", "為", "其", "賊", "道", "也", "，", "舉", "一", "而", "廢", "百", "也", "。", "」"]}
{"chapter": "7A", "id": 28, "passage": "孟子曰：「飢者甘食，渴者甘飲，是未得飲食之正也，飢渴害之也。豈惟口腹有飢渴之害？人心亦皆有害。人能無以飢渴之害為心害，則不及人不為憂矣。」", "tokens": ["孟子", "曰", "：", "「", "飢", "者", "甘", "食", "，", "渴", "者", "甘", "飲", "，", "是", "未", "得", "飲食", "之", "正", "也", "，", "飢渴", "害", "之", "也", "。", "豈", "惟", "口腹", "有", "飢渴", "之", "害", "？", "人心", "亦", "皆", "有", "害", "。", "人", "能", "無", "以", "飢渴", "之", "害", "為", "心", "害", "，", "則", "不", "及", "人", "不", "為", "憂", "矣", "。", "」"]}
{"chapter": "7A", "id": 29, "passage": "孟子曰：「柳下惠不以三公易其介。」", "tokens": ["孟子", "曰", "：", "「", "柳下惠", "不", "以", "三公", "易", "其", "介", "。", "」"]}
{"chapter": "7A", "id": 30, "passage": "孟子曰：「有為者辟若掘井，掘井九軔而不及泉，猶為棄井也。」", "tokens": ["孟子", "曰", "：", "「", "有", "為", "者", "辟", "若", "掘", "井", "，", "掘", "井", "九", "軔", "而", "不", "及", "泉", "，", "猶", "為", "棄", "井", "也", "。", "」"]}
{"chapter": "7A", "id": 31, "passage": "孟子曰：「堯舜，性之也；湯武，身之也；五霸，假之也。久假而不歸，惡知其非有也。」", "tokens": ["孟子", "曰", "：", "「", "堯舜", "，", "性", "之", "也", "；", "湯武", "，", "身", "之", "也", "；", "五霸", "，", "假", "之", "也", "。", "久", "假", "而", "不", "歸", "，", "惡", "知", "其", "非", "有", "也", "。", "」"]}
{"chapter": "7A", "id": 32, "passage": "公孫丑曰：「伊尹曰：『予不狎于不順。』放太甲于桐，民大悅。太甲賢。又反之，民大悅。賢者之為人臣也，其君不賢，則固可放與？」", "tokens": ["公孫丑", "曰", "：", "「", "伊尹", "曰", "：", "『", "予", "不", "狎", "于", "不", "順", "。", "』", "放", "太甲", "于", "桐", "，", "民", "大", "悅", "。", "太甲", "賢", "。", "又", "反", "之", "，", "民", "大", "悅", "。", "賢者", "之", "為", "人", "臣", "也", "，", "其", "君", "不", "賢", "，", "則", "固", "可", "放", "與", "？", "」"]}
{"chapter": "7A", "id": 33, "passage": "孟子曰：「有伊尹之志，則可；無伊尹之志，則篡也。」", "tokens": ["孟子", "曰", "：", "「", "有", "伊尹", "之", "志", "，", "則", "可", "；", "無", "伊尹", "之", "志", "，", "則", "篡", "也", "。", "」"]}
{"chapter": "7A", "id": 34, "passage": "公孫丑曰：「《詩》曰：『不素餐兮』，君子之不耕而食，何也？」", "tokens": ["公孫丑", "曰", "：", "「", "《", "詩", "》", "曰", "：", "『", "不", "素", "餐", "兮", "』", "，", "君子", "之", "不", "耕", "而", "食", "，", "何", "也", "？", "」"]}
{"chapter": "7A", "id": 35, "passage": "孟子曰：「君子居是國也，其君用之，則安富尊榮；其子弟從之，則孝弟忠信。『不素餐兮』，孰大於是？」", "tokens": ["孟子", "曰", "：", "「", "君子", "居", "是", "國", "也", "，", "其", "君", "用", "之", "，", "則", "安", "富", "尊", "榮", "；", "其", "子弟", "從", "之", "，", "則", "孝", "弟", "忠", "信", "。", "『", "不", "素", "餐", "兮", "』", "，", "孰", "大", "於", "是", "？", "」"]}
