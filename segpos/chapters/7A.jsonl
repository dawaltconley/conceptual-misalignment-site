{"chapter": "7A", "id": 47, "passage": "孟子自范之齊，望見齊王之子。喟然歎曰：「居移氣，養移體，大哉居乎！夫非盡人之子與？」", "tokens": ["孟子", "自", "范", "之", "齊", "，", "望", "見", "齊王", "之", "子", "。", "喟然", "歎", "曰", "：", "「", "居", "移", "氣", "，", "養", "移", "體", "，", "大", "哉", "居", "乎", "！", "夫", "非", "盡", "人", "之", "子", "與", "？", "」"]}
{"chapter": "7A", "id": 48, "passage": "孟子曰：「王子宮室、車馬、衣服多與人同，而王子若彼者，其居使之然也；況居天下之廣居者乎？魯君之宋，呼於垤澤之門。守者曰：『此非吾君也，何其聲之似我君也？』此無他，居相似也。」", "tokens": ["孟子", "曰", "：", "「", "王子", "宮室", "、", "車馬", "、", "衣服", "多", "與", "人", "同", "，", "而", "王子", "若", "彼", "者", "，", "其", "居", "使", "之", "然", "也", "；", "況", "居", "天下", "之", "廣", "居", "者", "乎", "？", "魯", "君", "之", "宋", "，", "呼", "於", "垤澤", "之", "門", "。", "守", "者", "曰", "：", "『", "此", "非", "吾", "君", "也", "，", "何", "其", "聲", "之", "似", "我", "君", "也", "？", "』", "此", "無", "他", "，", "居", "相", "似", "也", "。", "」"]}
{"chapter": "7A", "id": 49, "passage": "孟子曰：「食而弗愛，豕交之也；愛而不敬，獸畜之也。恭敬者，幣之未將者也。恭敬而無實，君子不可虛拘。」", "tokens": ["孟子", "曰", "：", "「", "食", "而", "弗", "愛", "，", "豕", "交", "之", "也", "；", "愛", "而", "不", "敬", "，", "獸", "畜", "之", "也", "。", "恭敬", "者", "，", "幣", "之", "未", "將", "者", "也", "。", "恭敬", "而", "無", "實", "，", "君子", "不", "可", "虛", "拘", "。", "」"]}
{"chapter": "7A", "id": 50, "passage": "孟子曰：「形色，天性也；惟聖人，然後可以踐形。」", "tokens": ["孟子", "曰", "：", "「", "形", "色", "，", "天性", "也", "；", "惟", "聖人", "，", "然後", "可以", "踐", "形", "。", "」"]}
{"chapter": "7A", "id": 51, "passage": "齊宣王欲短喪。公孫丑曰：「為朞之喪，猶愈於已乎？」", "tokens": ["齊宣王", "欲", "短", "喪", "。", "公孫丑", "曰", "：", "「", "為", "朞", "之", "喪", "，", "猶", "愈", "於", "已", "乎", "？", "」"]}
{"chapter": "7A", "id": 52, "passage": "孟子曰：「是猶或紾其兄之臂，子謂之姑徐徐云爾，亦教之孝弟而已矣。」", "tokens": ["孟子", "曰", "：", "「", "是", "猶", "或", "紾", "其", "兄", "之", "臂", "，", "子", "謂", "之", "姑", "徐徐", "云", "爾", "，", "亦", "教", "之", "孝", "弟", "而", "已", "矣", "。", "」"]}
{"chapter": "7A", "id": 53, "passage": "王子有其母死者，其傅為之請數月之喪。公孫丑曰：「若此者，何如也？」", "tokens": ["王子", "有", "其", "母", "死", "者", "，", "其", "傅", "為", "之", "請", "數", "月", "之", "喪", "。", "公孫丑", "曰", "：", "「", "若", "此", "者", "，", "何", "如", "也", "？", "」"]}
{"chapter": "7A", "id": 54, "passage": "曰：「是欲終之而不可得也。雖加一日愈於已，謂夫莫之禁而弗為者也。」", "tokens": ["曰", "：", "「", "是", "欲", "終", "之", "而", "不", "可", "得", "也", "。", "雖", "加", "一", "日", "愈", "於", "已", "，", "謂", "夫", "莫", "之", "禁", "而", "弗", "為", "者", "也", "。", "」"]}
{"chapter": "7A", "id": 55, "passage": "孟子曰：「君子之所以教者五：有如時雨化之者，有成德者，有達財者，有答問者，有私淑艾者。此五者，君子之所以教也。」", "tokens": ["孟子", "曰", "：", "「", "君子", "之", "所", "以", "教", "者", "五", "：", "有", "如", "時", "雨", "化", "之", "者", "，", "有", "成", "德", "者", "，", "有", "達", "財", "者", "，", "有", "答", "問", "者", "，", "有", "私", "淑", "艾", "者", "。", "此", "五", "者", "，", "君子", "之", "所", "以", "教", "也", "。", "」"]}
{"chapter": "7A", "id": 56, "passage": "公孫丑曰：「道則高矣，美矣，宜若登天然，似不可及也。何不使彼為可幾及而日孳孳也？」", "tokens": ["公孫丑", "曰", "：", "「", "道", "則", "高", "矣", "，", "美", "矣", "，", "宜", "若", "登", "天", "然", "，", "似", "不", "可", "及", "也", "。", "何", "不", "使", "彼", "為", "可", "幾", "及", "而", "日", "孳孳", "也", "？", "」"]}
{"chapter": "7A", "id": 57, "passage": "孟子曰：「大匠不為拙工改廢繩墨，羿不為拙射變其彀率。君子引而不發，躍如也。中道而立，能者從之。」", "tokens": ["孟子", "曰", "：", "「", "大匠", "不", "為", "拙工", "改", "廢", "繩墨", "，", "羿", "不", "為", "拙", "射", "變", "其", "彀率", "。", "君子", "引", "而", "不", "發", "，", "躍", "如", "也", "。", "中", "道", "而", "立", "，", "能", "者", "從", "之", "。", "」"]}
{"chapter": "7A", "id": 58, "passage": "孟子曰：「天下有道，以道殉身；天下無道，以身殉道。未聞以道殉乎人者也。」", "tokens": ["孟子", "曰", "：", "「", "天下", "有", "道", "，", "以", "道", "殉", "身", "；", "天下", "無", "道", "，", "以", "身", "殉", "道", "。", "未", "聞", "以", "道", "殉", "乎", "人", "者", "也", "。", "」"]}
{"chapter": "7A", "id": 59, "passage": "公都子曰：「滕更之在門也，若在所禮。而不答，何也？」", "tokens": ["公都子", "曰", "：", "「", "滕更", "之", "在", "門", "也", "，", "若", "在", "所", "禮", "。", "而", "不", "答", "，", "何", "也", "？", "」"]}
{"chapter": "7A", "id": 60, "passage": "孟子曰：「挾貴而問，挾賢而問，挾長而問，挾有勳勞而問，挾故而問，皆所不答也。滕更有二焉。」", "tokens": ["孟子", "曰", "：", "「", "挾", "貴", "而", "問", "，", "挾", "賢", "而", "問", "，", "挾", "長", "而", "問", "，", "挾", "有", "勳勞", "而", "問", "，", "挾", "故", "而", "問", "，", "皆", "所", "不", "答", "也", "。", "滕", "更", "有", "二", "焉", "。", "」"]}
{"chapter": "7A", "id": 61, "passage": "孟子曰：「於不可已而已者，無所不已；於所厚者薄，無所不薄也。其進銳者，其退速。」", "tokens": ["孟子", "曰", "：", "「", "於", "不", "可", "已", "而", "已", "者", "，", "無", "所", "不", "已", "；", "於", "所", "厚", "者", "薄", "，", "無", "所", "不", "薄", "也", "。", "其", "進", "銳", "者", "，", "其", "退", "速", "。", "」"]}
{"chapter": "7A", "id": 62, "passage": "孟子曰：「君子之於物也，愛之而弗仁；於民也，仁之而弗親。親親而仁民，仁民而愛物。」", "tokens": ["孟子", "曰", "：", "「", "君子", "之", "於", "物", "也", "，", "愛", "之", "而", "弗", "仁", "；", "於", "民", "也", "，", "仁", "之", "而", "弗", "親", "。", "親", "親", "而", "仁", "民", "，", "仁", "民", "而", "愛", "物", "。", "」"]}
{"chapter": "7A", "id": 63, "passage": "孟子曰：「知者無不知也，當務之為急；仁者無不愛也，急親賢之為務。堯舜之知而不遍物，急先務也；堯舜之仁不遍愛人，急親賢也。不能三年之喪，而緦小功之察；放飯流歠，而問無齒決，是之謂不知務。」", "tokens": ["孟子", "曰", "：", "「", "知", "者", "無", "不", "知", "也", "，", "當", "務", "之", "為", "急", "；", "仁", "者", "無", "不", "愛", "也", "，", "急", "親", "賢", "之", "為", "務", "。", "堯", "舜", "之", "知", "而", "不", "遍", "物", "，", "急", "先", "務", "也", "；", "堯", "舜", "之", "仁", "不", "遍", "愛", "人", "，", "急", "親", "賢", "也", "。", "不", "能", "三", "年", "之", "喪", "，", "而", "緦", "小", "功", "之", "察", "；", "放", "飯", "流", "歠", "，", "而", "問", "無", "齒", "決", "，", "是", "之", "謂", "不", "知", "務", "。", "」"]}
