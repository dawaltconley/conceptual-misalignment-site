{"chapter": "5A", "id": 2, "passage": "萬章曰：「父母愛之，喜而不忘；父母惡之，勞而不怨。然則舜怨乎？」", "tokens": ["萬章", "曰", "：", "「", "父母", "愛", "之", "，", "喜", "而", "不", "忘", "；", "父母", "惡", "之", "，", "勞", "而", "不", "怨", "。", "然", "則", "舜", "怨", "乎", "？", "」"]}
{"chapter": "5A", "id": 4, "passage": "萬章問曰：「《詩》云：『娶妻如之何？必告父母。』信斯言也，宜莫如舜。舜之不告而娶，何也？」", "tokens": ["萬章", "問", "曰", "：", "「", "《", "詩", "》", "云", "：", "『", "娶", "妻", "如", "之", "何", "？", "必", "告", "父", "母", "。", "』", "信", "斯", "言", "也", "，", "宜", "莫", "如", "舜", "。", "舜", "之", "不", "告", "而", "娶", "，", "何", "也", "？", "」"]}
{"chapter": "5A", "id": 5, "passage": "孟子曰：「告則不得娶。男女居室，人之大倫也。如告，則廢人之大倫，以懟父母，是以不告也。」", "tokens": ["孟子", "曰", "：", "「", "告", "則", "不", "得", "娶", "。", "男女", "居室", "，", "人", "之", "大倫", "也", "。", "如", "告", "，", "則", "廢", "人", "之", "大倫", "，", "以", "懟", "父母", "，", "是以", "不", "告", "也", "。", "」"]}
{"chapter": "5A", "id": 6, "passage": "萬章曰：「舜之不告而娶，則吾既得聞命矣；帝之妻舜而不告，何也？」", "tokens": ["萬章", "曰", "：", "「", "舜", "之", "不", "告", "而", "娶", "，", "則", "吾", "既", "得", "聞", "命", "矣", "；", "帝", "之", "妻", "舜", "而", "不", "告", "，", "何", "也", "？", "」"]}
