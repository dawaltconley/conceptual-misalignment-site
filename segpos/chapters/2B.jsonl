{"chapter": "2B", "id": 14, "passage": "曰：「今有受人之牛羊而為之牧之者，則必為之求牧與芻矣。求牧與芻而不得，則反諸其人乎？抑亦立而視其死與？」", "tokens": ["曰", "：", "「", "今", "有", "受", "人", "之", "牛羊", "而", "為", "之", "牧", "之", "者", "，", "則", "必", "為", "之", "求", "牧", "與", "芻", "矣", "。", "求", "牧", "與", "芻", "而", "不", "得", "，", "則", "反", "諸", "其", "人", "乎", "？", "抑", "亦", "立", "而", "視", "其", "死", "與", "？", "」"]}
{"chapter": "2B", "id": 15, "passage": "曰：「此則距心之罪也。」", "tokens": ["曰", "：", "「", "此", "則", "距", "心", "之", "罪", "也", "。", "」"]}
{"chapter": "2B", "id": 16, "passage": "他日，見於王曰：「王之為都者，臣知五人焉。知其罪者，惟孔距心。為王誦之。」王曰：「此則寡人之罪也。」", "tokens": ["他日", "，", "見", "於", "王", "曰", "：", "「", "王", "之", "為", "都", "者", "，", "臣", "知", "五", "人", "焉", "。", "知", "其", "罪", "者", "，", "惟", "孔", "距心", "。", "為", "王", "誦", "之", "。", "」", "王", "曰", "：", "「", "此", "則", "寡人", "之", "罪", "也", "。", "」"]}
{"chapter": "2B", "id": 17, "passage": "孟子謂蚔鼃曰：「子之辭靈丘而請士師，似也，為其可以言也。今既數月矣，未可以言與？」", "tokens": ["孟子", "謂", "蚔鼃", "曰", "：", "「", "子", "之", "辭", "靈丘", "而", "請", "士師", "，", "似", "也", "，", "為", "其", "可以", "言", "也", "。", "今", "既", "數", "月", "矣", "，", "未", "可以", "言", "與", "？", "」"]}
{"chapter": "2B", "id": 18, "passage": "蚔鼃諫於王而不用，致為臣而去。齊人曰：「所以為蚔鼃，則善矣；所以自為，則吾不知也。」", "tokens": ["蚔鼃", "諫", "於", "王", "而", "不", "用", "，", "致", "為", "臣", "而", "去", "。", "齊", "人", "曰", "：", "「", "所", "以", "為", "蚔鼃", "，", "則", "善", "矣", "；", "所", "以", "自", "為", "，", "則", "吾", "不", "知", "也", "。", "」"]}
{"chapter": "2B", "id": 19, "passage": "公都子以告。曰：「吾聞之也：有官守者，不得其職則去；有言責者，不得其言則去。我無官守，我無言責也，則吾進退，豈不綽綽然有餘裕哉？」", "tokens": ["公都子", "以", "告", "。", "曰", "：", "「", "吾", "聞", "之", "也", "：", "有", "官", "守", "者", "，", "不", "得", "其", "職", "則", "去", "；", "有", "言", "責", "者", "，", "不", "得", "其", "言", "則", "去", "。", "我", "無", "官", "守", "，", "我", "無", "言", "責", "也", "，", "則", "吾", "進退", "，", "豈", "不", "綽綽", "然", "有", "餘裕", "哉", "？", "」"]}
{"chapter": "2B", "id": 20, "passage": "孟子為卿於齊，出吊於滕，王使蓋大夫王驩為輔行。王驩朝暮見，反齊滕之路，未嘗與之言行事也。", "tokens": ["孟子", "為", "卿", "於", "齊", "，", "出", "吊", "於", "滕", "，", "王", "使", "蓋大夫", "王驩", "為", "輔行", "。", "王驩", "朝", "暮", "見", "，", "反", "齊", "滕", "之", "路", "，", "未", "嘗", "與", "之", "言", "行", "事", "也",  "。"]}
{"chapter": "2B", "id": 21, "passage": "公孫丑曰：「齊卿之位，不為小矣；齊滕之路，不為近矣。反之而未嘗與言行事，何也？」", "tokens": ["公孫丑", "曰", "：", "「", "齊卿", "之", "位", "，", "不", "為", "小", "矣", "；", "齊滕", "之", "路", "，", "不", "為", "近", "矣", "。", "反", "之", "而", "未", "嘗", "與", "言", "行", "事", "，", "何", "也", "？", "」"]}
{"chapter": "2B", "id": 22, "passage": "曰：「夫既或治之，予何言哉？」", "tokens": ["曰", "：", "「", "夫", "既", "或", "治", "之", "，", "予", "何", "言", "哉", "？", "」"]}
{"chapter": "2B", "id": 23, "passage": "孟子自齊葬於魯，反於齊，止於嬴。", "tokens": ["孟子", "自", "齊", "葬", "於", "魯", "，", "反", "於", "齊", "，", "止", "於", "嬴", "。"]}
{"chapter": "2B", "id": 24, "passage": "充虞請曰：「前日不知虞之不肖，使虞敦匠事。嚴，虞不敢請。今願竊有請也，木若以美然。」", "tokens": ["充虞", "請", "曰", "：", "「", "前日", "不", "知", "虞", "之", "不肖", "，", "使", "虞", "敦", "匠", "事", "。", "嚴", "，", "虞", "不", "敢", "請", "。", "今", "願", "竊", "有", "請", "也", "，", "木", "若", "以", "美", "然", "。", "」"]}
{"chapter": "2B", "id": 25, "passage": "曰：「古者棺槨無度，中古棺七寸，槨稱之。自天子達於庶人。非直為觀美也，然後盡於人心。不得，不可以為悅；無財，不可以為悅。得之為有財，古之人皆用之，吾何為獨不然？且比化者，無使土親膚，於人心獨無恔乎？吾聞之君子：不以天下儉其親。」", "tokens": ["曰", "：", "「", "古", "者", "棺", "槨", "無", "度", "，", "中", "古", "棺", "七", "寸", "，", "槨", "稱", "之", "。", "自", "天子", "達", "於", "庶人", "。", "非", "直", "為", "觀", "美", "也", "，", "然後", "盡", "於", "人心", "。", "不", "得", "，", "不", "可", "以", "為", "悅", "；", "無", "財", "，", "不", "可", "以", "為", "悅", "。", "得", "之", "為", "有", "財", "，", "古", "之", "人", "皆", "用", "之", "，", "吾", "何", "為", "獨", "不", "然", "？", "且", "比", "化", "者", "，", "無", "使", "土", "親", "膚", "，", "於", "人", "心", "獨", "無", "恔", "乎", "？", "吾", "聞", "之", "君子", "：", "不", "以", "天下", "儉", "其", "親", "。", "」"]}
{"chapter": "2B", "id": 26, "passage": "沈同以其私問曰：「燕可伐與？」", "tokens": ["沈同", "以", "其", "私", "問", "曰", "：", "「", "燕", "可", "伐", "與", "？", "」"]}
{"chapter": "2B", "id": 27, "passage": "孟子曰：「可。子噲不得與人燕，子之不得受燕於子噲。有仕於此，而子悅之，不告於王而私與之吾子之祿爵；夫士也，亦無王命而私受之於子，則可乎？何以異於是？」", "tokens": ["孟子", "曰", "：", "「", "可", "。", "子噲", "不", "得", "與", "人", "燕", "，", "子之", "不", "得", "受", "燕", "於", "子噲", "。", "有", "仕", "於", "此", "，", "而", "子", "悅", "之", "，", "不", "告", "於", "王", "而", "私", "與", "之", "吾", "子", "之", "祿", "爵", "；", "夫", "士", "也", "，", "亦", "無", "王", "命", "而", "私", "受", "之", "於", "子", "，", "則", "可", "乎", "？", "何", "以", "異", "於", "是", "？", "」"]}
{"chapter": "2B", "id": 28, "passage": "齊人伐燕。或問曰：「勸齊伐燕，有諸？」", "tokens": ["齊人", "伐", "燕", "。", "或", "問", "曰", "：", "「", "勸", "齊", "伐", "燕", "，", "有", "諸", "？", "」"]}
{"chapter": "2B", "id": 29, "passage": "曰：「未也。沈同問『燕可伐與』？吾應之曰『可』，彼然而伐之也。彼如曰『孰可以伐之』？則將應之曰：『為天吏，則可以伐之。』今有殺人者，或問之曰『人可殺與』？則將應之曰『可』。彼如曰『孰可以殺之』？則將應之曰：『為士師，則可以殺之。』今以燕伐燕，何為勸之哉？」", "tokens": ["曰", "：", "「", "未", "也", "。", "沈同", "問", "『", "燕", "可", "伐", "與", "』", "？", "吾", "應", "之", "曰", "『", "可", "』", "，", "彼", "然", "而", "伐", "之", "也", "。", "彼", "如", "曰", "『", "孰", "可以", "伐", "之", "』", "？", "則", "將", "應", "之", "曰", "：", "『", "為", "天吏", "，", "則", "可以", "伐", "之", "。", "』", "今", "有", "殺", "人", "者", "，", "或", "問", "之", "曰", "『", "人", "可", "殺", "與", "』", "？", "則", "將", "應", "之", "曰", "『", "可", "』", "。", "彼", "如", "曰", "『", "孰", "可以", "殺", "之", "』", "？", "則", "將", "應", "之", "曰", "：", "『", "為", "士師", "，", "則", "可以", "殺", "之", "。", "』", "今", "以", "燕", "伐", "燕", "，", "何", "為", "勸", "之", "哉", "？", "」"]}
