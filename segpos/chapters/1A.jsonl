{"chapter": "1A", "id": 27, "passage": "曰：「臣聞之胡齕曰，王坐於堂上，有牽牛而過堂下者，王見之，曰：『牛何之？』對曰：『將以釁鐘。』王曰：『舍之！吾不忍其觳觫，若無罪而就死地。』對曰：『然則廢釁鐘與？』曰：『何可廢也？以羊易之！』不識有諸？」", "tokens": ["曰", "：", "「", "臣", "聞", "之", "胡齕", "曰", "，", "王", "坐", "於", "堂", "上", "，", "有", "牽", "牛", "而", "過", "堂", "下", "者", "，", "王", "見", "之", "，", "曰", "：", "『", "牛", "何", "之", "？", "』", "對", "曰", "：", "『", "將", "以", "釁", "鐘", "。", "』", "王", "曰", "：", "『", "舍", "之", "！", "吾", "不", "忍", "其", "觳觫", "，", "若", "無", "罪", "而", "就", "死", "地", "。", "』", "對", "曰", "：", "『", "然", "則", "廢", "釁", "鐘", "與", "？", "』", "曰", "：", "『", "何", "可", "廢", "也", "？", "以", "羊", "易", "之", "！", "』", "不", "識", "有", "諸", "？", "」"]}
{"chapter": "1A", "id": 28, "passage": "曰：「有之。」", "tokens": ["曰", "：", "「", "有", "之", "。", "」"]}
{"chapter": "1A", "id": 29, "passage": "曰：「是心足以王矣。百姓皆以王為愛也，臣固知王之不忍也。」", "tokens": ["曰", "：", "「", "是", "心", "足", "以", "王", "矣", "。", "百", "姓", "皆", "以", "王", "為", "愛", "也", "，", "臣", "固", "知", "王", "之", "不", "忍", "也", "。", "」"]}
{"chapter": "1A", "id": 30, "passage": "王曰：「然。誠有百姓者。齊國雖褊小，吾何愛一牛？即不忍其觳觫，若無罪而就死地，故以羊易之也。」", "tokens": ["王", "曰", "：", "「", "然", "。", "誠", "有", "百姓", "者", "。", "齊國", "雖", "褊", "小", "，", "吾", "何", "愛", "一", "牛", "？", "即", "不", "忍", "其", "觳觫", "，", "若", "無", "罪", "而", "就", "死", "地", "，", "故", "以", "羊", "易", "之", "也", "。", "」"]}
{"chapter": "1A", "id": 31, "passage": "曰：「王無異於百姓之以王為愛也。以小易大，彼惡知之？王若隱其無罪而就死地，則牛羊何擇焉？」", "tokens": ["曰", "：", "「", "王", "無", "異", "於", "百姓", "之", "以", "王", "為", "愛", "也", "。", "以", "小", "易", "大", "，", "彼", "惡", "知", "之", "？", "王", "若", "隱", "其", "無", "罪", "而", "就", "死", "地", "，", "則", "牛", "羊", "何", "擇", "焉", "？", "」"]}
{"chapter": "1A", "id": 32, "passage": "王笑曰：「是誠何心哉？我非愛其財。而易之以羊也，宜乎百姓之謂我愛也。」", "tokens": ["王", "笑", "曰", "：", "「", "是", "誠", "何", "心", "哉", "？", "我", "非", "愛", "其", "財", "。", "而", "易", "之", "以", "羊", "也", "，", "宜", "乎", "百姓", "之", "謂", "我", "愛", "也", "。", "」"]}
{"chapter": "1A", "id": 33, "passage": "曰：「無傷也，是乃仁術也，見牛未見羊也。君子之於禽獸也，見其生，不忍見其死；聞其聲，不忍食其肉。是以君子遠庖廚也。」", "tokens": ["曰", "：", "「", "無", "傷", "也", "，", "是", "乃", "仁", "術", "也", "，", "見", "牛", "未", "見", "羊", "也", "。", "君子", "之", "於", "禽獸", "也", "，", "見", "其", "生", "，", "不", "忍", "見", "其", "死", "；", "聞", "其", "聲", "，", "不", "忍", "食", "其", "肉", "。", "是以", "君子", "遠", "庖廚", "也", "。", "」"]}
{"chapter": "1A", "id": 34, "passage": "王說曰：「《詩》云：『他人有心，予忖度之。』夫子之謂也。夫我乃行之，反而求之，不得吾心。夫子言之，於我心有戚戚焉。此心之所以合於王者，何也？」", "tokens": ["王", "說", "曰", "：", "「", "《", "詩", "》", "云", "：", "『", "他人", "有", "心", "，", "予", "忖度", "之", "。", "』", "夫子", "之", "謂", "也", "。", "夫", "我", "乃", "行", "之", "，", "反", "而", "求", "之", "，", "不", "得", "吾", "心", "。", "夫子", "言", "之", "，", "於", "我", "心", "有", "戚戚", "焉", "。", "此", "心", "之", "所", "以", "合", "於", "王", "者", "，", "何", "也", "？", "」"]}
{"chapter": "1A", "id": 35, "passage": "曰：「有復於王者曰：『吾力足以舉百鈞』，而不足以舉一羽；『明足以察秋毫之末』，而不見輿薪，則王許之乎？」", "tokens": ["曰", "：", "「", "有", "復", "於", "王", "者", "曰", "：", "『", "吾", "力", "足以", "舉", "百", "鈞", "』", "，", "而", "不", "足以", "舉", "一", "羽", "；", "『", "明", "足", "以", "察", "秋", "毫", "之", "末", "』", "，", "而", "不", "見", "輿", "薪", "，", "則", "王", "許", "之", "乎", "？", "」"]}
{"chapter": "1A", "id": 36, "passage": "曰：「否。」", "tokens": ["曰", "：", "「", "否", "。", "」"]}
{"chapter": "1A", "id": 37, "passage": "「今恩足以及禽獸，而功不至於百姓者，獨何與？然則一羽之不舉，為不用力焉；輿薪之不見，為不用明焉，百姓之不見保，為不用恩焉。故王之不王，不為也，非不能也。」", "tokens": ["「", "今", "恩", "足", "以", "及", "禽獸", "，", "而", "功", "不", "至", "於", "百姓", "者", "，", "獨", "何", "與", "？", "然", "則", "一", "羽", "之", "不", "舉", "，", "為", "不", "用", "力", "焉", "；", "輿", "薪", "之", "不", "見", "，", "為", "不", "用", "明", "焉", "，", "百姓", "之", "不", "見", "保", "，", "為", "不", "用", "恩", "焉", "。", "故", "王", "之", "不", "王", "，", "不", "為", "也", "，", "非", "不", "能", "也", "。", "」"]}
{"chapter": "1A", "id": 38, "passage": "曰：「不為者與不能者之形何以異？」", "tokens": ["曰", "：", "「", "不", "為", "者", "與", "不", "能", "者", "之", "形", "何", "以", "異", "？", "」"]}
{"chapter": "1A", "id": 40, "passage": "王曰：「否。吾何快於是？將以求吾所大欲也。」", "tokens": ["王", "曰", "：", "「", "否", "。", "吾", "何", "快", "於", "是", "？", "將", "以", "求", "吾", "所", "大", "欲", "也", "。", "」"]}
{"chapter": "1A", "id": 41, "passage": "曰：「王之所大欲可得聞與？」王笑而不言。", "tokens": ["曰", "：", "「", "王", "之", "所", "大", "欲", "可", "得", "聞", "與", "？", "」", "王", "笑", "而", "不", "言", "。"]}
{"chapter": "1A", "id": 42, "passage": "曰：「為肥甘不足於口與？輕煖不足於體與？抑為采色不足視於目與？聲音不足聽於耳與？便嬖不足使令於前與？王之諸臣皆足以供之，而王豈為是哉？」", "tokens": ["曰", "：", "「", "為", "肥", "甘", "不", "足", "於", "口", "與", "？", "輕", "煖", "不", "足", "於", "體", "與", "？", "抑", "為", "采", "色", "不", "足", "視", "於", "目", "與", "？", "聲", "音", "不", "足", "聽", "於", "耳", "與", "？", "便", "嬖", "不", "足", "使", "令", "於", "前", "與", "？", "王", "之", "諸", "臣", "皆", "足", "以", "供", "之", "，", "而", "王", "豈", "為", "是", "哉", "？", "」"]}
{"chapter": "1A", "id": 43, "passage": "曰：「否。吾不為是也。」", "tokens": ["曰", "：", "「", "否", "。", "吾", "不", "為", "是", "也", "。", "」"]}
{"chapter": "1A", "id": 44, "passage": "曰：「然則王之所大欲可知已。欲辟土地，朝秦楚，莅中國而撫四夷也。以若所為求若所欲，猶緣木而求魚也。」", "tokens": ["曰", "：", "「", "然", "則", "王", "之", "所", "大", "欲", "可", "知", "已", "。", "欲", "辟", "土地", "，", "朝", "秦", "楚", "，", "莅", "中國", "而", "撫", "四夷", "也", "。", "以", "若", "所", "為", "求", "若", "所", "欲", "，", "猶", "緣", "木", "而", "求", "魚", "也", "。", "」"]}
{"chapter": "1A", "id": 45, "passage": "王曰：「若是其甚與？」", "tokens": ["王", "曰", "：", "「", "若是", "其", "甚", "與", "？", "」"]}
{"chapter": "1A", "id": 46, "passage": "曰：「殆有甚焉。緣木求魚，雖不得魚，無後災。以若所為，求若所欲，盡心力而為之，後必有災。」", "tokens": ["曰", "：", "「", "殆", "有", "甚", "焉", "。", "緣", "木", "求", "魚", "，", "雖", "不", "得", "魚", "，", "無", "後", "災", "。", "以", "若", "所", "為", "，", "求", "若", "所", "欲", "，", "盡", "心", "力", "而", "為", "之", "，", "後", "必", "有", "災", "。", "」"]}
{"chapter": "1A", "id": 47, "passage": "曰：「可得聞與？」", "tokens": ["曰", "：", "「", "可", "得", "聞", "與", "？", "」"]}
{"chapter": "1A", "id": 48, "passage": "曰：「鄒人與楚人戰，則王以為孰勝？」", "tokens": ["曰", "：", "「", "鄒", "人", "與", "楚", "人", "戰", "，", "則", "王", "以", "為", "孰", "勝", "？", "」"]}
{"chapter": "1A", "id": 49, "passage": "曰：「楚人勝。」", "tokens": ["曰", "：", "「", "楚", "人", "勝", "。", "」"]}
{"chapter": "1A", "id": 50, "passage": "曰：「然則小固不可以敵大，寡固不可以敵眾，弱固不可以敵彊。海內之地方千里者九，齊集有其一。以一服八，何以異於鄒敵楚哉？蓋亦反其本矣。今王發政施仁，使天下仕者皆欲立於王之朝，耕者皆欲耕於王之野，商賈皆欲藏於王之市，行旅皆欲出於王之塗，天下之欲疾其君者皆欲赴愬於王。其若是，孰能禦之？」", "tokens": ["曰", "：", "「", "然", "則", "小", "固", "不", "可以", "敵", "大", "，", "寡", "固", "不", "可以", "敵", "眾", "，", "弱", "固", "不", "可以", "敵", "彊", "。", "海內", "之", "地", "方", "千", "里", "者", "九", "，", "齊", "集", "有", "其", "一", "。", "以", "一", "服", "八", "，", "何", "以", "異", "於", "鄒", "敵", "楚", "哉", "？", "蓋", "亦", "反", "其", "本", "矣", "。", "今", "王", "發", "政", "施", "仁", "，", "使", "天下", "仕", "者", "皆", "欲", "立", "於", "王", "之", "朝", "，", "耕", "者", "皆", "欲", "耕", "於", "王", "之", "野", "，", "商賈", "皆", "欲", "藏", "於", "王", "之", "市", "，", "行", "旅", "皆", "欲", "出", "於", "王", "之", "塗", "，", "天下", "之", "欲", "疾", "其", "君", "者", "皆", "欲", "赴", "愬", "於", "王", "。", "其", "若是", "，", "孰", "能", "禦", "之", "？", "」"]}
{"chapter": "1A", "id": 51, "passage": "王曰：「吾惛，不能進於是矣。願夫子輔吾志，明以教我。我雖不敏，請嘗試之。」", "tokens": ["王", "曰", "：", "「", "吾", "惛", "，", "不", "能", "進", "於", "是", "矣", "。", "願", "夫子", "輔", "吾", "志", "，", "明", "以", "教", "我", "。", "我", "雖", "不", "敏", "，", "請", "嘗", "試", "之", "。", "」"]}
