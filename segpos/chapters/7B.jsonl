{"chapter": "7B", "id": 41, "passage": "孟子之滕，館於上宮。有業屨於牖上，館人求之弗得。或問之曰：「若是乎從者之廀也？」", "tokens": ["孟子", "之", "滕", "，", "館", "於", "上宮", "。", "有", "業", "屨", "於", "牖", "上", "，", "館", "人", "求", "之", "弗", "得", "。", "或", "問", "之", "曰", "：", "「", "若是", "乎", "從", "者", "之", "廀", "也", "？", "」"]}
{"chapter": "7B", "id": 42, "passage": "曰：「子以是為竊屨來與？」", "tokens": ["曰", "：", "「", "子", "以", "是", "為", "竊", "屨", "來", "與", "？", "」"]}
{"chapter": "7B", "id": 43, "passage": "曰：「殆非也。夫子之設科也，往者不追，來者不距。苟以是心至，斯受之而已矣。」", "tokens": ["曰", "：", "「", "殆", "非", "也", "。", "夫子", "之", "設", "科", "也", "，", "往", "者", "不", "追", "，", "來", "者", "不", "距", "。", "苟", "以", "是", "心", "至", "，", "斯", "受", "之", "而", "已", "矣", "。", "」"]}
{"chapter": "7B", "id": 44, "passage": "孟子曰：「人皆有所不忍，達之於其所忍，仁也；人皆有所不為，達之於其所為，義也。人能充無欲害人之心，而仁不可勝用也；人能充無穿踰之心，而義不可勝用也。人能充無受爾汝之實，無所往而不為義也。士未可以言而言，是以言餂之也；可以言而不言，是以不言餂之也，是皆穿踰之類也。」", "tokens": ["孟子", "曰", "：", "「", "人", "皆", "有", "所", "不", "忍", "，", "達", "之", "於", "其", "所", "忍", "，", "仁", "也", "；", "人", "皆", "有", "所", "不", "為", "，", "達", "之", "於", "其", "所", "為", "，", "義", "也", "。", "人", "能", "充", "無", "欲", "害", "人", "之", "心", "，", "而", "仁", "不", "可", "勝", "用", "也", "；", "人", "能", "充", "無", "穿", "踰", "之", "心", "，", "而", "義", "不", "可", "勝", "用", "也", "。", "人", "能", "充", "無", "受", "爾", "汝", "之", "實", "，", "無", "所", "往", "而", "不", "為", "義", "也", "。", "士", "未", "可", "以", "言", "而", "言", "，", "是以", "言", "餂", "之", "也", "；", "可", "以", "言", "而", "不", "言", "，", "是以", "不", "言", "餂", "之", "也", "，", "是", "皆", "穿", "踰", "之", "類", "也", "。", "」"]}
{"chapter": "7B", "id": 45, "passage": "孟子曰：「言近而指遠者，善言也；守約而施博者，善道也。君子之言也，不下帶而道存焉。君子之守，修其身而天下平。人病舍其田而芸人之田，所求於人者重，而所以自任者輕。」", "tokens": ["孟子", "曰", "：", "「", "言", "近", "而", "指", "遠", "者", "，", "善", "言", "也", "；", "守", "約", "而", "施", "博", "者", "，", "善", "道", "也", "。", "君子", "之", "言", "也", "，", "不", "下", "帶", "而", "道", "存", "焉", "。", "君子", "之", "守", "，", "修", "其", "身", "而", "天下", "平", "。", "人", "病", "舍", "其", "田", "而", "芸", "人", "之", "田", "，", "所", "求", "於", "人", "者", "重", "，", "而", "所", "以", "自", "任", "者", "輕", "。", "」"]}
{"chapter": "7B", "id": 46, "passage": "孟子曰：「堯舜，性者也；湯武，反之也。動容周旋中禮者，盛德之至也；哭死而哀，非為生者也；經德不回，非以干祿也；言語必信，非以正行也。君子行法，以俟命而已矣。」", "tokens": ["孟子", "曰", "：", "「", "堯舜", "，", "性", "者", "也", "；", "湯武", "，", "反之", "也", "。", "動", "容", "周旋", "中", "禮", "者", "，", "盛", "德", "之", "至", "也", "；", "哭", "死", "而", "哀", "，", "非", "為", "生者", "也", "；", "經", "德", "不", "回", "，", "非", "以", "干", "祿", "也", "；", "言", "語", "必", "信", "，", "非", "以", "正", "行", "也", "。", "君子", "行", "法", "，", "以", "俟", "命", "而", "已", "矣", "。", "」"]}
{"chapter": "7B", "id": 48, "passage": "孟子曰：「養心莫善於寡欲。其為人也寡欲，雖有不存焉者，寡矣；其為人也多欲，雖有存焉者，寡矣。」", "tokens": ["孟子", "曰", "：", "「", "養", "心", "莫", "善", "於", "寡", "欲", "。", "其", "為", "人", "也", "寡", "欲", "，", "雖", "有", "不", "存", "焉", "者", "，", "寡", "矣", "；", "其", "為", "人", "也", "多", "欲", "，", "雖", "有", "存", "焉", "者", "，", "寡", "矣", "。", "」"]}
{"chapter": "7B", "id": 49, "passage": "曾皙嗜羊棗，而曾子不忍食羊棗。公孫丑問曰：「膾炙與羊棗孰美？」", "tokens": ["曾皙", "嗜", "羊棗", "，", "而", "曾子", "不", "忍", "食", "羊棗", "。", "公孫丑", "問", "曰", "：", "「", "膾炙", "與", "羊棗", "孰", "美", "？", "」"]}
{"chapter": "7B", "id": 50, "passage": "孟子曰：「膾炙哉！」", "tokens": ["孟子", "曰", "：", "「", "膾", "炙", "哉", "！", "」"]}
{"chapter": "7B", "id": 51, "passage": "公孫丑曰：「然則曾子何為食膾炙而不食羊棗？」", "tokens": ["公孫丑", "曰", "：", "「", "然", "則", "曾子", "何", "為", "食", "膾炙", "而", "不", "食", "羊棗", "？", "」"]}
{"chapter": "7B", "id": 52, "passage": "曰：「膾炙所同也，羊棗所獨也。諱名不諱姓，姓所同也，名所獨也。」", "tokens": ["曰", "：", "「", "膾", "炙", "所", "同", "也", "，", "羊", "棗", "所", "獨", "也", "。", "諱", "名", "不", "諱", "姓", "，", "姓", "所", "同", "也", "，", "名", "所", "獨", "也", "。", "」"]}
{"chapter": "7B", "id": 53, "passage": "萬章問曰：「孔子在陳曰：『盍歸乎來！吾黨之士狂簡，進取，不忘其初。』孔子在陳，何思魯之狂士？」", "tokens": ["萬章", "問", "曰", "：", "「", "孔子", "在", "陳", "曰", "：", "『", "盍", "歸", "乎", "來", "！", "吾", "黨", "之", "士", "狂簡", "，", "進取", "，", "不", "忘", "其", "初", "。", "』", "孔子", "在", "陳", "，", "何", "思", "魯", "之", "狂士", "？", "」"]}
{"chapter": "7B", "id": 54, "passage": "孟子曰：「孔子『不得中道而與之，必也狂獧乎！狂者進取，獧者有所不為也』。孔子豈不欲中道哉？不可必得，故思其次也。」", "tokens": ["孟子", "曰", "：", "「", "孔子", "『", "不", "得", "中道", "而", "與", "之", "，", "必", "也", "狂獧", "乎", "！", "狂", "者", "進", "取", "，", "獧", "者", "有", "所", "不", "為", "也", "』", "。", "孔子", "豈", "不", "欲", "中道", "哉", "？", "不", "可", "必", "得", "，", "故", "思", "其", "次", "也", "。", "」"]}
{"chapter": "7B", "id": 55, "passage": "「敢問何如斯可謂狂矣？」", "tokens": ["「敢", "問", "何", "如", "斯", "可", "謂", "狂", "矣", "？", "」"]}
{"chapter": "7B", "id": 56, "passage": "曰：「如琴張、曾皙、牧皮者，孔子之所謂狂矣。」", "tokens": ["曰", "：", "「", "如", "琴張", "、", "曾皙", "、", "牧皮", "者", "，", "孔子", "之", "所", "謂", "狂", "矣", "。", "」"]}
{"chapter": "7B", "id": 57, "passage": "「何以謂之狂也？」", "tokens": ["「", "何", "以", "謂", "之", "狂", "也", "？", "」"]}
{"chapter": "7B", "id": 58, "passage": "曰：「其志嘐嘐然，曰『古之人，古之人』。夷考其行而不掩焉者也。狂者又不可得，欲得不屑不潔之士而與之，是獧也，是又其次也。孔子曰：『過我門而不入我室，我不憾焉者，其惟鄉原乎！鄉原，德之賊也。』」", "tokens": ["曰", "：", "「", "其", "志", "嘐嘐", "然", "，", "曰", "『", "古", "之", "人", "，", "古", "之", "人", "』", "。", "夷", "考", "其", "行", "而", "不", "掩", "焉", "者", "也", "。", "狂", "者", "又", "不", "可", "得", "，", "欲", "得", "不", "屑", "不", "潔", "之", "士", "而", "與", "之", "，", "是", "獧", "也", "，", "是", "又", "其", "次", "也", "。", "孔子", "曰", "：", "『", "過", "我", "門", "而", "不", "入", "我", "室", "，", "我", "不", "憾", "焉", "者", "，", "其", "惟", "鄉", "原", "乎", "！", "鄉", "原", "，", "德", "之", "賊", "也", "。", "』", "」"]}
{"chapter": "7B", "id": 59, "passage": "曰：「何如斯可謂之鄉原矣？」", "tokens": ["曰", "：", "「", "何", "如", "斯", "可", "謂", "之", "鄉原", "矣", "？", "」"]}
{"chapter": "7B", "id": 60, "passage": "曰：「『何以是嘐嘐也？言不顧行，行不顧言，則曰：古之人，古之人。行何為踽踽涼涼？生斯世也，為斯世也，善斯可矣。』閹然媚於世也者，是鄉原也。」", "tokens": ["曰", "：", "「", "『", "何", "以", "是", "嘐嘐", "也", "？", "言", "不", "顧行", "，", "行", "不", "顧", "言", "，", "則", "曰", "：", "古", "之", "人", "，", "古", "之", "人", "。", "行", "何", "為", "踽踽", "涼涼", "？", "生", "斯", "世", "也", "，", "為", "斯", "世", "也", "，", "善", "斯", "可", "矣", "。", "』", "閹", "然", "媚", "於", "世", "也", "者", "，", "是", "鄉", "原", "也", "。", "」"]}
{"chapter": "7B", "id": 61, "passage": "萬子曰：「一鄉皆稱原人焉，無所往而不為原人，孔子以為德之賊，何哉？」", "tokens": ["萬子", "曰", "：", "「", "一", "鄉", "皆", "稱", "原人", "焉", "，", "無", "所", "往", "而", "不", "為", "原人", "，", "孔子", "以為", "德", "之", "賊", "，", "何", "哉", "？", "」"]}
{"chapter": "7B", "id": 62, "passage": "曰：「非之無舉也，刺之無刺也；同乎流俗，合乎汙世；居之似忠信，行之似廉潔；眾皆悅之，自以為是，而不可與入堯舜之道，故曰德之賊也。孔子曰：『惡似而非者：惡莠，恐其亂苗也；惡佞，恐其亂義也；惡利口，恐其亂信也；惡鄭聲，恐其亂樂也；惡紫，恐其亂朱也；惡鄉原，恐其亂德也。』君子反經而已矣。經正，則庶民興；庶民興，斯無邪慝矣。」", "tokens": ["曰", "：", "「", "非", "之", "無", "舉", "也", "，", "刺", "之", "無", "刺", "也", "；", "同", "乎", "流俗", "，", "合", "乎", "汙世", "；", "居", "之", "似", "忠信", "，", "行", "之", "似", "廉潔", "；", "眾", "皆", "悅", "之", "，", "自", "以為", "是", "，", "而", "不", "可", "與", "入", "堯舜", "之", "道", "，", "故", "曰", "德", "之", "賊", "也", "。", "孔子", "曰", "：", "『", "惡", "似", "而", "非", "者", "：", "惡", "莠", "，", "恐", "其", "亂", "苗", "也", "；", "惡", "佞", "，", "恐", "其", "亂", "義", "也", "；", "惡", "利", "口", "，", "恐", "其", "亂", "信", "也", "；", "惡", "鄭", "聲", "，", "恐", "其", "亂", "樂", "也", "；", "惡", "紫", "，", "恐", "其", "亂", "朱", "也", "；", "惡", "鄉", "原", "，", "恐", "其", "亂", "德", "也", "。", "』", "君子", "反", "經", "而", "已", "矣", "。", "經", "正", "，", "則", "庶民", "興", "；", "庶民", "興", "，", "斯", "無", "邪慝", "矣", "。", "」"]}
