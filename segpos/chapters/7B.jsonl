{"chapter": "7B", "id": 33, "passage": "「何謂善？何謂信？」", "tokens": ["「", "何", "謂", "善", "？", "何", "謂", "信", "？", "」"]}
{"chapter": "7B", "id": 34, "passage": "曰：「可欲之謂善，有諸己之謂信。充實之謂美，充實而有光輝之謂大，大而化之之謂聖，聖而不可知之之謂神。樂正子，二之中，四之下也。」", "tokens": ["曰", "：", "「", "可", "欲", "之", "謂", "善", "，", "有", "諸", "己", "之", "謂", "信", "。", "充", "實", "之", "謂", "美", "，", "充", "實", "而", "有", "光輝", "之", "謂", "大", "，", "大", "而", "化", "之", "之", "謂", "聖", "，", "聖", "而", "不", "可", "知", "之", "之", "謂", "神", "。", "樂", "正子", "，", "二", "之", "中", "，", "四", "之", "下", "也", "。", "」"]}
{"chapter": "7B", "id": 35, "passage": "孟子曰：「逃墨必歸於楊，逃楊必歸於儒。歸，斯受之而已矣。今之與楊墨辯者，如追放豚，既入其苙，又從而招之。」", "tokens": ["孟子", "曰", "：", "「", "逃", "墨", "必", "歸", "於", "楊", "，", "逃", "楊", "必", "歸", "於", "儒", "。", "歸", "，", "斯", "受", "之", "而", "已", "矣", "。", "今", "之", "與", "楊", "墨", "辯", "者", "，", "如", "追", "放", "豚", "，", "既", "入", "其", "苙", "，", "又", "從", "而", "招", "之", "。", "」"]}
{"chapter": "7B", "id": 36, "passage": "孟子曰：「有布縷之征，粟米之征，力役之征。君子用其一，緩其二。用其二而民有殍，用其三而父子離。」", "tokens": ["孟子", "曰", "：", "「", "有", "布縷", "之", "征", "，", "粟米", "之", "征", "，", "力役", "之", "征", "。", "君子", "用", "其", "一", "，", "緩", "其", "二", "。", "用", "其", "二", "而", "民", "有", "殍", "，", "用", "其", "三", "而", "父子", "離", "。", "」"]}
{"chapter": "7B", "id": 37, "passage": "孟子曰：「諸侯之寶三：土地，人民，政事。寶珠玉者，殃必及身。」", "tokens": ["孟子", "曰", "：", "「", "諸侯", "之", "寶", "三", "：", "土地", "，", "人民", "，", "政事", "。", "寶", "珠", "玉", "者", "，", "殃", "必", "及", "身", "。", "」"]}
