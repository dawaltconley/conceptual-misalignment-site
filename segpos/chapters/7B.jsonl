{"chapter": "7B", "id": 2, "passage": "「梁惠王以土地之故，糜爛其民而戰之，大敗，將復之，恐不能勝，故驅其所愛子弟以殉之，是之謂以其所不愛及其所愛也。」", "tokens": ["「梁惠王", "以", "土地", "之", "故", "，", "糜爛", "其", "民", "而", "戰", "之", "，", "大", "敗", "，", "將", "復", "之", "，", "恐", "不", "能", "勝", "，", "故", "驅", "其", "所", "愛", "子", "弟", "以", "殉", "之", "，", "是", "之", "謂", "以", "其", "所", "不", "愛", "及", "其", "所", "愛", "也", "。", "」"]}
{"chapter": "7B", "id": 3, "passage": "孟子曰：「《春秋》無義戰。彼善於此，則有之矣。征者上伐下也，敵國不相征也。」", "tokens": ["孟子", "曰", "：", "「", "《", "春秋", "》", "無", "義", "戰", "。", "彼", "善", "於", "此", "，", "則", "有", "之", "矣", "。", "征", "者", "上", "伐", "下", "也", "，", "敵", "國", "不", "相", "征", "也", "。", "」"]}
{"chapter": "7B", "id": 5, "passage": "孟子曰：「有人曰：『我善為陳，我善為戰。』大罪也。國君好仁，天下無敵焉。南面而征北狄怨，東面而征西夷怨。曰：『奚為後我？』武王之伐殷也，革車三百兩，虎賁三千人。王曰：『無畏！寧爾也，非敵百姓也。』若崩厥角稽首。征之為言正也，各欲正己也，焉用戰？」", "tokens": ["孟子", "曰", "：", "「", "有", "人", "曰", "：", "『", "我", "善", "為", "陳", "，", "我", "善", "為", "戰", "。", "』", "大", "罪", "也", "。", "國", "君", "好", "仁", "，", "天下", "無", "敵", "焉", "。", "南", "面", "而", "征", "北", "狄", "怨", "，", "東", "面", "而", "征", "西", "夷", "怨", "。", "曰", "：", "『", "奚", "為", "後", "我", "？", "』", "武王", "之", "伐", "殷", "也", "，", "革車", "三", "百", "兩", "，", "虎賁", "三", "千", "人", "。", "王", "曰", "：", "『", "無", "畏", "！", "寧", "爾", "也", "，", "非", "敵", "百姓", "也", "。", "』", "若", "崩", "厥", "角", "稽", "首", "。", "征", "之", "為", "言", "正", "也", "，", "各", "欲", "正", "己", "也", "，", "焉", "用", "戰", "？", "」"]}
{"chapter": "7B", "id": 6, "passage": "孟子曰：「梓匠輪輿能與人規矩，不能使人巧。」", "tokens": ["孟子", "曰", "：", "「", "梓匠", "輪輿", "能", "與", "人", "規矩", "，", "不", "能", "使", "人", "巧", "。", "」"]}
{"chapter": "7B", "id": 7, "passage": "孟子曰：「舜之飯糗茹草也，若將終身焉；及其為天子也，被袗衣，鼓琴，二女果，若固有之。」", "tokens": ["孟子", "曰", "：", "「", "舜", "之", "飯", "糗", "茹", "草", "也", "，", "若", "將", "終身", "焉", "；", "及", "其", "為", "天子", "也", "，", "被", "袗", "衣", "，", "鼓", "琴", "，", "二", "女", "果", "，", "若", "固", "有", "之", "。", "」"]}
{"chapter": "7B", "id": 8, "passage": "孟子曰：「吾今而後知殺人親之重也：殺人之父，人亦殺其父；殺人之兄，人亦殺其兄。然則非自殺之也，一閒耳。」", "tokens": ["孟子", "曰", "：", "「", "吾", "今", "而後", "知", "殺", "人", "親", "之", "重", "也", "：", "殺", "人", "之", "父", "，", "人", "亦", "殺", "其", "父", "；", "殺", "人", "之", "兄", "，", "人", "亦", "殺", "其", "兄", "。", "然", "則", "非", "自", "殺", "之", "也", "，", "一", "閒", "耳", "。", "」"]}
{"chapter": "7B", "id": 9, "passage": "孟子曰：「古之為關也，將以禦暴。今之為關也，將以為暴。」", "tokens": ["孟子", "曰", "：", "「", "古", "之", "為", "關", "也", "，", "將", "以", "禦", "暴", "。", "今", "之", "為", "關", "也", "，", "將", "以", "為", "暴", "。", "」"]}
{"chapter": "7B", "id": 10, "passage": "孟子曰：「身不行道，不行於妻子；使人不以道，不能行於妻子。」", "tokens": ["孟子", "曰", "：", "「", "身", "不", "行", "道", "，", "不", "行", "於", "妻子", "；", "使", "人", "不", "以", "道", "，", "不", "能", "行", "於", "妻子", "。", "」"]}
{"chapter": "7B", "id": 11, "passage": "孟子曰：「周于利者，凶年不能殺；周于德者，邪世不能亂。」", "tokens": ["孟子", "曰", "：", "「", "周", "于", "利", "者", "，", "凶年", "不", "能", "殺", "；", "周", "于", "德", "者", "，", "邪", "世", "不", "能", "亂", "。", "」"]}
{"chapter": "7B", "id": 12, "passage": "孟子曰：「好名之人，能讓千乘之國；苟非其人，簞食豆羹見於色。」", "tokens": ["孟子", "曰", "：", "「", "好", "名", "之", "人", "，", "能", "讓", "千", "乘", "之", "國", "；", "苟", "非", "其", "人", "，", "簞", "食", "豆", "羹", "見", "於", "色", "。", "」"]}
{"chapter": "7B", "id": 14, "passage": "孟子曰：「不仁而得國者，有之矣；不仁而得天下，未之有也。」", "tokens": ["孟子", "曰", "：", "「", "不", "仁", "而", "得", "國", "者", "，", "有", "之", "矣", "；", "不", "仁", "而", "得", "天下", "，", "未", "之", "有", "也", "。", "」"]}
{"chapter": "7B", "id": 16, "passage": "孟子曰：「聖人，百世之師也，伯夷、柳下惠是也。故聞伯夷之風者，頑夫廉，懦夫有立志；聞柳下惠之風者，薄夫敦，鄙夫寬。奮乎百世之上。百世之下，聞者莫不興起也。非聖人而能若是乎，而況於親炙之者乎？」", "tokens": ["孟子", "曰", "：", "「", "聖人", "，", "百世", "之", "師", "也", "，", "伯夷", "、", "柳下惠", "是", "也", "。", "故", "聞", "伯夷", "之", "風", "者", "，", "頑夫", "廉", "，", "懦夫", "有", "立志", "；", "聞", "柳下惠", "之", "風", "者", "，", "薄夫", "敦", "，", "鄙夫", "寬", "。", "奮", "乎", "百世", "之上", "。", "百世", "之下", "，", "聞", "者", "莫", "不", "興", "起", "也", "。", "非", "聖人", "而", "能", "若是", "乎", "，", "而", "況", "於", "親", "炙", "之", "者", "乎", "？", "」"]}
{"chapter": "7B", "id": 17, "passage": "孟子曰：「仁也者，人也。合而言之，道也。」", "tokens": ["孟子", "曰", "：", "「", "仁", "也", "者", "，", "人", "也", "。", "合", "而", "言", "之", "，", "道", "也", "。", "」"]}
{"chapter": "7B", "id": 18, "passage": "孟子曰：「孔子之去魯，曰：『遲遲吾行也。』去父母國之道也。去齊，接淅而行，去他國之道也。」", "tokens": ["孟子", "曰", "：", "「", "孔子", "之", "去", "魯", "，", "曰", "：", "『", "遲遲", "吾", "行", "也", "。", "』", "去", "父母", "國", "之", "道", "也", "。", "去", "齊", "，", "接", "淅", "而", "行", "，", "去", "他", "國", "之", "道", "也", "。", "」"]}
{"chapter": "7B", "id": 19, "passage": "孟子曰：「君子之戹於陳蔡之閒，無上下之交也。」", "tokens": ["孟子", "曰", "：", "「", "君子", "之", "戹", "於", "陳", "蔡", "之", "閒", "，", "無", "上", "下", "之", "交", "也", "。", "」"]}
