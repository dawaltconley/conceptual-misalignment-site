{"chapter": "3B", "id": 10, "passage": "曰：「晉國亦仕國也，未嘗聞仕如此其急。仕如此其急也，君子之難仕，何也？」", "tokens": ["曰", "：", "「", "晉國", "亦", "仕", "國", "也", "，", "未", "嘗", "聞", "仕", "如此", "其", "急", "。", "仕", "如此", "其", "急", "也", "，", "君子", "之", "難", "仕", "，", "何", "也", "？", "」"]}
{"chapter": "3B", "id": 11, "passage": "曰：「丈夫生而願為之有室，女子生而願為之有家。父母之心，人皆有之。不待父母之命、媒妁之言，鑽穴隙相窺，踰牆相從，則父母國人皆賤之。古之人未嘗不欲仕也，又惡不由其道。不由其道而往者，與鑽穴隙之類也。」", "tokens": ["曰", "：", "「", "丈夫", "生", "而", "願", "為", "之", "有", "室", "，", "女子", "生", "而", "願", "為", "之", "有", "家", "。", "父母", "之", "心", "，", "人", "皆", "有", "之", "。", "不", "待", "父母", "之", "命", "、", "媒妁", "之", "言", "，", "鑽", "穴", "隙", "相", "窺", "，", "踰", "牆", "相", "從", "，", "則", "父母", "國人", "皆", "賤", "之", "。", "古", "之人", "未", "嘗", "不", "欲", "仕", "也", "，", "又", "惡", "不", "由", "其", "道", "。", "不", "由", "其", "道", "而", "往", "者", "，", "與", "鑽", "穴", "隙", "之", "類", "也", "。", "」"]}
{"chapter": "3B", "id": 12, "passage": "彭更問曰：「後車數十乘，從者數百人，以傳食於諸侯，不以泰乎？」", "tokens": ["彭更", "問", "曰", "：", "「", "後車", "數", "十", "乘", "，", "從者", "數", "百", "人", "，", "以", "傳", "食", "於", "諸侯", "，", "不", "以", "泰", "乎", "？", "」"]}
{"chapter": "3B", "id": 13, "passage": "孟子曰：「非其道，則一簞食不可受於人；如其道，則舜受堯之天下，不以為泰，子以為泰乎？」", "tokens": ["孟子", "曰", "：", "「", "非", "其", "道", "，", "則", "一", "簞", "食", "不", "可", "受", "於", "人", "；", "如", "其", "道", "，", "則", "舜", "受", "堯", "之", "天下", "，", "不", "以", "為", "泰", "，", "子", "以", "為", "泰", "乎", "？", "」"]}
{"chapter": "3B", "id": 14, "passage": "曰：「否。士無事而食，不可也。」", "tokens": ["曰", "：", "「", "否", "。", "士", "無", "事", "而", "食", "，", "不", "可", "也", "。", "」"]}
{"chapter": "3B", "id": 15, "passage": "曰：「子不通功易事，以羡補不足，則農有餘粟，女有餘布；子如通之，則梓匠輪輿皆得食於子。於此有人焉，入則孝，出則悌，守先王之道，以待後之學者，而不得食於子。子何尊梓匠輪輿而輕為仁義者哉？」", "tokens": ["曰", "：", "「", "子", "不", "通", "功", "易", "事", "，", "以", "羡", "補", "不", "足", "，", "則", "農", "有", "餘", "粟", "，", "女", "有", "餘", "布", "；", "子", "如", "通", "之", "，", "則", "梓匠", "輪輿", "皆", "得", "食", "於", "子", "。", "於", "此", "有", "人", "焉", "，", "入", "則", "孝", "，", "出", "則", "悌", "，", "守", "先王", "之", "道", "，", "以", "待", "後", "之", "學", "者", "，", "而", "不", "得", "食", "於", "子", "。", "子", "何", "尊", "梓匠", "輪輿", "而", "輕", "為", "仁", "義", "者", "哉", "？", "」"]}
{"chapter": "3B", "id": 16, "passage": "曰：「梓匠輪輿，其志將以求食也；君子之為道也，其志亦將以求食與？」", "tokens": ["曰", "：", "「", "梓匠", "輪輿", "，", "其", "志", "將", "以", "求", "食", "也", "；", "君子", "之", "為", "道", "也", "，", "其", "志", "亦", "將", "以", "求", "食", "與", "？", "」"]}
{"chapter": "3B", "id": 17, "passage": "曰：「子何以其志為哉？其有功於子，可食而食之矣。且子食志乎？食功乎？」", "tokens": ["曰", "：", "「", "子", "何", "以", "其", "志", "為", "哉", "？", "其", "有", "功", "於", "子", "，", "可", "食", "而", "食", "之", "矣", "。", "且", "子", "食", "志", "乎", "？", "食", "功", "乎", "？", "」"]}
