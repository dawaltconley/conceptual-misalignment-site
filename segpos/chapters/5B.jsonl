{"chapter": "5B", "id": 29, "passage": "孟子曰：「不敢也。諸侯失國，而後託於諸侯，禮也；士之託於諸侯，非禮也。」", "tokens": ["孟子", "曰", "：", "「", "不敢", "也", "。", "諸侯", "失", "國", "，", "而", "後", "託", "於", "諸侯", "，", "禮", "也", "；", "士", "之", "託", "於", "諸侯", "，", "非", "禮", "也", "。", "」"]}
