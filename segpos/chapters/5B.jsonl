{"chapter": "5B", "id": 14, "passage": "曰：「尊者賜之，曰『其所取之者，義乎，不義乎」，而後受之，以是為不恭，故弗卻也。」", "tokens": ["曰", "：", "「", "尊", "者", "賜", "之", "，", "曰", "『", "其", "所", "取", "之", "者", "，", "義", "乎", "，", "不", "義", "乎", "」", "，", "而", "後", "受", "之", "，", "以", "是", "為", "不", "恭", "，", "故", "弗", "卻", "也", "。", "」"]}
{"chapter": "5B", "id": 15, "passage": "曰：「請無以辭卻之，以心卻之，曰『其取諸民之不義也』，而以他辭無受，不可乎？」", "tokens": ["曰", "：", "「", "請", "無", "以", "辭", "卻", "之", "，", "以", "心", "卻", "之", "，", "曰", "『", "其", "取", "諸", "民", "之", "不", "義", "也", "』", "，", "而", "以", "他", "辭", "無", "受", "，", "不", "可", "乎", "？", "」"]}
