{"chapter": "5B", "id": 42, "passage": "萬章曰：「敢問不見諸侯，何義也？」", "tokens": ["萬章", "曰", "：", "「", "敢", "問", "不", "見", "諸侯", "，", "何", "義", "也", "？", "」"]}
{"chapter": "5B", "id": 43, "passage": "孟子曰：「在國曰市井之臣，在野曰草莽之臣，皆謂庶人。庶人不傳質為臣，不敢見於諸侯，禮也。」", "tokens": ["孟子", "曰", "：", "「", "在", "國", "曰", "市", "井", "之", "臣", "，", "在", "野", "曰", "草", "莽", "之", "臣", "，", "皆", "謂", "庶人", "。", "庶人", "不", "傳", "質", "為", "臣", "，", "不", "敢", "見", "於", "諸侯", "，", "禮", "也", "。", "」"]}
{"chapter": "5B", "id": 44, "passage": "萬章曰：「庶人，召之役，則往役；君欲見之，召之，則不往見之，何也？」", "tokens": ["萬章", "曰", "：", "「", "庶人", "，", "召", "之", "役", "，", "則", "往", "役", "；", "君", "欲", "見", "之", "，", "召", "之", "，", "則", "不", "往", "見", "之", "，", "何", "也", "？", "」"]}
{"chapter": "5B", "id": 45, "passage": "曰：「往役，義也；往見，不義也。且君之欲見之也，何為也哉？」", "tokens": ["曰", "：", "「", "往", "役", "，", "義", "也", "；", "往", "見", "，", "不", "義", "也", "。", "且", "君", "之", "欲", "見", "之", "也", "，", "何", "為", "也", "哉", "？", "」"]}
