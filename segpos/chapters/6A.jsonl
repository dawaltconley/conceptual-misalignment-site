{"chapter": "6A", "id": 32, "passage": "孟子曰：「從其大體為大人，從其小體為小人。」", "tokens": ["孟子", "曰", "：", "「", "從", "其", "大", "體", "為", "大人", "，", "從", "其", "小", "體", "為", "小人", "。", "」"]}
