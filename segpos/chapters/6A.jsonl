{"chapter": "6A", "id": 8, "passage": "告子曰：「食色，性也。仁，內也，非外也；義，外也，非內也。」", "tokens": ["告子", "曰", "：", "「", "食", "色", "，", "性", "也", "。", "仁", "，", "內", "也", "，", "非", "外", "也", "；", "義", "，", "外", "也", "，", "非", "內", "也", "。", "」"]}
