{"chapter": "6A", "id": 5, "passage": "孟子曰：「生之謂性也，猶白之謂白與？」曰：「然。」", "tokens": ["孟子", "曰", "：", "「", "生", "之", "謂", "性", "也", "，", "猶", "白", "之", "謂", "白", "與", "？", "」", "曰", "：", "「", "然", "。", "」"]}
{"chapter": "6A", "id": 6, "passage": "「白羽之白也，猶白雪之白；白雪之白，猶白玉之白與？」曰：「然。」", "tokens": ["「白羽", "之", "白", "也", "，", "猶", "白雪", "之", "白", "；", "白雪", "之", "白", "，", "猶", "白玉", "之", "白", "與", "？", "」", "曰", "：", "「", "然", "。", "」"]}
