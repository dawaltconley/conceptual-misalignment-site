{"chapter": "6A", "id": 10, "passage": "曰：「彼長而我長之，非有長於我也；猶彼白而我白之，從其白於外也，故謂之外也。」", "tokens": ["曰", "：", "「", "彼", "長", "而", "我", "長", "之", "，", "非", "有", "長", "於", "我", "也", "；", "猶", "彼", "白", "而", "我", "白", "之", "，", "從", "其", "白", "於", "外", "也", "，", "故", "謂", "之", "外", "也", "。", "」"]}
{"chapter": "6A", "id": 11, "passage": "曰：「異於白馬之白也，無以異於白人之白也；不識長馬之長也，無以異於長人之長與？且謂長者義乎？長之者義乎？」", "tokens": ["曰", "：", "「", "異", "於", "白馬", "之", "白", "也", "，", "無", "以", "異", "於", "白人", "之", "白", "也", "；", "不", "識", "長馬", "之", "長", "也", "，", "無", "以", "異", "於", "長人", "之", "長", "與", "？", "且", "謂", "長", "者", "義", "乎", "？", "長", "之", "者", "義", "乎", "？", "」"]}
{"chapter": "6A", "id": 12, "passage": "曰：「吾弟則愛之，秦人之弟則不愛也，是以我為悅者也，故謂之內。長楚人之長，亦長吾之長，是以長為悅者也，故謂之外也。」", "tokens": ["曰", "：", "「", "吾", "弟", "則", "愛", "之", "，", "秦", "人", "之", "弟", "則", "不", "愛", "也", "，", "是以", "我", "為", "悅", "者", "也", "，", "故", "謂", "之", "內", "。", "長", "楚", "人", "之", "長", "，", "亦", "長", "吾", "之", "長", "，", "是以", "長", "為", "悅", "者", "也", "，", "故", "謂", "之", "外", "也", "。", "」"]}
{"chapter": "6A", "id": 13, "passage": "曰：「耆秦人之炙，無以異於耆吾炙。夫物則亦有然者也，然則耆炙亦有外與？」", "tokens": ["曰", "：", "「", "耆", "秦", "人", "之", "炙", "，", "無", "以", "異", "於", "耆", "吾", "炙", "。", "夫", "物", "則", "亦", "有", "然", "者", "也", "，", "然", "則", "耆", "炙", "亦", "有", "外", "與", "？", "」"]}
{"chapter": "6A", "id": 14, "passage": "孟季子問公都子曰：「何以謂義內也？」曰：「行吾敬，故謂之內也。」", "tokens": ["孟季子", "問", "公都子", "曰", "：", "「", "何", "以", "謂", "義", "內", "也", "？", "」", "曰", "：", "「", "行", "吾", "敬", "，", "故", "謂", "之", "內", "也", "。", "」"]}
{"chapter": "6A", "id": 15, "passage": "「鄉人長於伯兄一歲，則誰敬？」曰：「敬兄。」", "tokens": ["「", "鄉人", "長", "於", "伯兄", "一", "歲", "，", "則", "誰", "敬", "？", "」", "曰", "：", "「", "敬", "兄", "。", "」"]}
{"chapter": "6A", "id": 16, "passage": "「酌則誰先？」曰：「先酌鄉人。」", "tokens": ["「", "酌", "則", "誰", "先", "？", "」", "曰", "：", "「", "先", "酌", "鄉人", "。", "」"]}
