{"chapter": "4B", "id": 0, "passage": "孟子曰：「舜生於諸馮，遷於負夏，卒於鳴條，東夷之人也。文王生於岐周，卒於畢郢，西夷之人也。地之相去也，千有餘里；世之相後也，千有餘歲。得志行乎中國，若合符節。先聖後聖，其揆一也。」", "tokens": ["孟子", "曰", "：", "「", "舜", "生", "於", "諸馮", "，", "遷", "於", "負夏", "，", "卒", "於", "鳴條", "，", "東夷", "之", "人", "也", "。", "文王", "生", "於", "岐周", "，", "卒", "於", "畢郢", "，", "西夷", "之", "人", "也", "。", "地", "之", "相", "去", "也", "，", "千", "有", "餘", "里", "；", "世", "之", "相", "後", "也", "，", "千", "有", "餘", "歲", "。", "得", "志", "行", "乎", "中國", "，", "若", "合", "符節", "。", "先", "聖", "後", "聖", "，", "其", "揆", "一", "也", "。", "」"]}
{"chapter": "4B", "id": 1, "passage": "子產聽鄭國之政，以其乘輿濟人於溱洧。孟子曰：「惠而不知為政。歲十一月徒杠成，十二月輿梁成，民未病涉也。君子平其政，行辟人可也。焉得人人而濟之？故為政者，每人而悅之，日亦不足矣。」", "tokens": ["子產", "聽", "鄭國", "之", "政", "，", "以", "其", "乘輿", "濟", "人", "於", "溱", "洧", "。", "孟子", "曰", "：", "「", "惠", "而", "不", "知", "為", "政", "。", "歲", "十一月", "徒", "杠", "成", "，", "十二月", "輿", "梁", "成", "，", "民", "未", "病", "涉", "也", "。", "君子", "平", "其", "政", "，", "行", "辟", "人", "可", "也", "。", "焉", "得", "人", "人", "而", "濟", "之", "？", "故", "為", "政", "者", "，", "每", "人", "而", "悅", "之", "，", "日", "亦", "不", "足", "矣", "。", "」"]}
{"chapter": "4B", "id": 2, "passage": "孟子告齊宣王曰：「君之視臣如手足，則臣視君如腹心；君之視臣如犬馬，則臣視君如國人；君之視臣如土芥，則臣視君如寇讎。」", "tokens": ["孟子", "告", "齊宣王", "曰", "：", "「", "君", "之", "視", "臣", "如", "手足", "，", "則", "臣", "視", "君", "如", "腹心", "；", "君", "之", "視", "臣", "如", "犬馬", "，", "則", "臣", "視", "君", "如", "國人", "；", "君", "之", "視", "臣", "如", "土芥", "，", "則", "臣", "視", "君", "如", "寇讎", "。", "」"]}
{"chapter": "4B", "id": 3, "passage": "王曰：「禮，為舊君有服，何如斯可為服矣？」", "tokens": ["王", "曰", "：", "「", "禮", "，", "為", "舊君", "有", "服", "，", "何", "如", "斯", "可", "為", "服", "矣", "？", "」"]}
{"chapter": "4B", "id": 4, "passage": "曰：「諫行言聽，膏澤下於民；有故而去，則君使人導之出疆，又先於其所往；去三年不反，然後收其田里。此之謂三有禮焉。如此，則為之服矣。今也為臣，諫則不行，言則不聽；膏澤不下於民；有故而去，則君搏執之，又極之於其所往；去之日，遂收其田里。此之謂寇讎。寇讎何服之有？」", "tokens": ["曰", "：", "「", "諫", "行", "言", "聽", "，", "膏澤", "下", "於", "民", "；", "有", "故", "而", "去", "，", "則", "君", "使", "人", "導", "之", "出", "疆", "，", "又", "先", "於", "其", "所", "往", "；", "去", "三", "年", "不", "反", "，", "然", "後", "收", "其", "田", "里", "。", "此", "之", "謂", "三", "有", "禮", "焉", "。", "如", "此", "，", "則", "為", "之", "服", "矣", "。", "今", "也", "為", "臣", "，", "諫", "則", "不", "行", "，", "言", "則", "不", "聽", "；", "膏澤", "不", "下", "於", "民", "；", "有", "故", "而", "去", "，", "則", "君", "搏", "執", "之", "，", "又", "極", "之", "於", "其", "所", "往", "；", "去", "之", "日", "，", "遂", "收", "其", "田", "里", "。", "此", "之", "謂", "寇", "讎", "。", "寇", "讎", "何", "服", "之", "有", "？", "」"]}
{"chapter": "4B", "id": 5, "passage": "孟子曰：「無罪而殺士，則大夫可以去；無罪而戮民，則士可以徙。」", "tokens": ["孟子", "曰", "：", "「", "無", "罪", "而", "殺", "士", "，", "則", "大夫", "可以", "去", "；", "無", "罪", "而", "戮", "民", "，", "則", "士", "可以", "徙", "。", "」"]}
{"chapter": "4B", "id": 6, "passage": "孟子曰：「君仁莫不仁，君義莫不義。」", "tokens": ["孟子", "曰", "：", "「", "君", "仁", "莫", "不", "仁", "，", "君", "義", "莫", "不", "義", "。", "」"]}
{"chapter": "4B", "id": 7, "passage": "孟子曰：「非禮之禮，非義之義，大人弗為。」", "tokens": ["孟子", "曰", "：", "「", "非", "禮", "之", "禮", "，", "非", "義", "之", "義", "，", "大人", "弗", "為", "。", "」"]}
{"chapter": "4B", "id": 8, "passage": "孟子曰：「中也養不中，才也養不才，故人樂有賢父兄也。如中也棄不中，才也棄不才，則賢不肖之相去，其閒不能以寸。」", "tokens": ["孟子", "曰", "：", "「", "中", "也", "養", "不", "中", "，", "才", "也", "養", "不", "才", "，", "故", "人", "樂", "有", "賢", "父兄", "也", "。", "如", "中", "也", "棄", "不", "中", "，", "才", "也", "棄", "不", "才", "，", "則", "賢", "不", "肖", "之", "相", "去", "，", "其", "閒", "不", "能", "以", "寸", "。", "」"]}
{"chapter": "4B", "id": 9, "passage": "孟子曰：「人有不為也，而後可以有為。」", "tokens": ["孟子", "曰", "：", "「", "人", "有", "不", "為", "也", "，", "而", "後", "可", "以", "有", "為", "。", "」"]}
