{"chapter": "4B", "id": 12, "passage": "孟子曰：「大人者，言不必信，行不必果，惟義所在。」", "tokens": ["孟子", "曰", "：", "「", "大人", "者", "，", "言", "不", "必", "信", "，", "行", "不", "必", "果", "，", "惟", "義", "所", "在", "。", "」"]}
