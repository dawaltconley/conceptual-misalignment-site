{"chapter": "1B", "id": 0, "passage": "莊暴見孟子，曰：「暴見於王，王語暴以好樂，暴未有以對也。」曰：「好樂何如？」", "tokens": ["莊暴", "見", "孟子", "，", "曰", "：", "「", "暴", "見", "於", "王", "，", "王", "語", "暴", "以", "好", "樂", "，", "暴", "未", "有", "以", "對", "也", "。", "」", "曰", "：", "「", "好", "樂", "何", "如", "？", "」"]}
